{
  "name": "Message",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "announcement"
      ],
      "description": "Direct message or class announcement"
    },
    "conversation_id": {
      "type": "string",
      "description": "Stable conversation key: school_id + ':' + sorted([sender_profile_id, recipient_profile_id]).join('|'). Same pair always maps to the same conversation."
    },
    "sender_profile_id": {
      "type": "string",
      "description": "UserProfile.id of the sender (effective persona in Test Mode)"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "teacher",
        "student",
        "parent",
        "admin"
      ]
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "teacher",
        "student",
        "parent",
        "admin"
      ],
      "description": "Canonical sender role (mirrors sender_type)"
    },
    "recipient_profile_id": {
      "type": "string",
      "description": "UserProfile.id of the recipient (effective persona in Test Mode)"
    },
    "recipient_email": {
      "type": "string",
      "description": "For direct messages"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_role": {
      "type": "string",
      "enum": [
        "teacher",
        "student",
        "parent",
        "admin"
      ]
    },
    "class_id": {
      "type": "string",
      "description": "For class announcements"
    },
    "class_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "read"
      ],
      "default": "sent"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "parent_message_id": {
      "type": "string",
      "description": "For threaded conversations"
    }
  },
  "required": [
    "type",
    "sender_email",
    "sender_name",
    "content"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.profile.school_id}}",
      "data.sender_email": "{{user.email}}"
    },
    "read": {
      "$and": [
        {
          "data.school_id": "{{user.profile.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.sender_email": "{{user.email}}"
            },
            {
              "data.recipient_email": "{{user.email}}"
            },
            {
              "data.sender_profile_id": "{{user.profile.id}}"
            },
            {
              "data.recipient_profile_id": "{{user.profile.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.profile.school_id}}"
        },
        {
          "$or": [
            {
              "data.sender_email": "{{user.email}}"
            },
            {
              "data.recipient_email": "{{user.email}}"
            },
            {
              "data.recipient_profile_id": "{{user.profile.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.profile.school_id}}",
      "user_condition": {
        "role": "admin"
      }
    }
  }
}