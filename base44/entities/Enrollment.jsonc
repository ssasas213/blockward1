{
  "name": "Enrollment",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Foreign key to School.id"
    },
    "class_id": {
      "type": "string",
      "description": "Foreign key to Class.id"
    },
    "class_name": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "year_group_id": {
      "type": "string",
      "description": "Foreign key to YearGroup.id"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "school_id",
    "class_id",
    "student_email"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.class_id": {
            "$in": "{{user.profile.class_ids}}"
          }
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.class_id": {
            "$in": "{{user.profile.class_ids}}"
          }
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.profile.school_id}}",
      "user_condition": {
        "role": "admin"
      }
    }
  }
}