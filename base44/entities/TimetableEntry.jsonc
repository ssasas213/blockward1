{
  "name": "TimetableEntry",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "day_of_week": {
      "type": "number",
      "description": "0=Monday, 1=Tuesday, etc."
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM format"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM format"
    },
    "room": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "period_number": {
      "type": "number"
    }
  },
  "required": [
    "class_id",
    "day_of_week",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.profile.school_id}}",
      "user_condition": {
        "role": "teacher"
      },
      "data.teacher_email": "{{user.email}}"
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "student"
          },
          "data.class_id": {
            "$in": "{{user.profile.class_ids}}"
          }
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.teacher_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.teacher_email": "{{user.email}}"
        }
      ]
    }
  }
}