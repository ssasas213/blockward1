{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "description": "StudentRecord.id"
    },
    "school_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "admin",
        "teacher",
        "student"
      ],
      "description": "Who signed"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "submitted",
        "teacher_signed",
        "teacher_rejected",
        "admin_signed",
        "admin_rejected",
        "student_signed",
        "drive_saved",
        "status_changed",
        "viewed",
        "sent_to_student_vault",
        "school_created",
        "join_request_submitted",
        "teacher_approved",
        "changes_requested",
        "resubmitted_after_changes"
      ],
      "description": "What happened"
    },
    "old_status": {
      "type": "string"
    },
    "new_status": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "record_id",
    "school_id",
    "actor_email",
    "action",
    "timestamp"
  ],
  "rls": {
    "create": {},
    "read": {
      "data.school_id": "{{user.profile.school_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    }
  }
}