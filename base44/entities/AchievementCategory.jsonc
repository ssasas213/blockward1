{
  "name": "AchievementCategory",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Owner email \u2014 RLS anchor. Categories are per-person organisation, never shared."
    },
    "name": {
      "type": "string",
      "description": "Category name (e.g. 'University Applications')"
    },
    "icon": {
      "type": "string",
      "description": "Icon key from the fixed whitelist (e.g. 'GraduationCap', 'Rocket')"
    },
    "color": {
      "type": "string",
      "description": "Colour key from the fixed palette (e.g. 'blue', 'amber', 'green')"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order, lower first"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "True for the ten starter categories seeded on first use"
    }
  },
  "required": [
    "owner_email",
    "name"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "data.owner_email": "{{user.email}}"
    },
    "update": {
      "data.owner_email": "{{user.email}}"
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}