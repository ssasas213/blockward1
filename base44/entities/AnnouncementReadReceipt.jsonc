{
  "name": "AnnouncementReadReceipt",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "announcement_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "User email who read it"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "announcement_id",
    "user_id",
    "read_at"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.profile.school_id}}",
      "user_condition": {
        "role": "admin"
      }
    }
  }
}