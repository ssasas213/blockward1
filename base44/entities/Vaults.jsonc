{
  "name": "Vaults",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Foreign key to User.id"
    },
    "school_id": {
      "type": "string",
      "description": "School this vault belongs to (RLS scope). Populated on create."
    },
    "address": {
      "type": "string",
      "description": "EVM wallet address (0x...)"
    },
    "chain": {
      "type": "string",
      "enum": [
        "sepolia",
        "amoy",
        "polygon"
      ],
      "default": "sepolia"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "locked"
      ],
      "default": "active"
    },
    "private_key_encrypted": {
      "type": "string",
      "description": "Encrypted private key - NEVER expose to frontend. Vaults reads are admin/service-role only; owners retrieve sanitized vault info via the getStudentVault backend function."
    }
  },
  "required": [
    "user_id",
    "address",
    "chain"
  ],
  "rls": {
    "create": {
      "data.school_id": "__service_role_only__"
    },
    "read": {
      "$and": [
        {
          "data.school_id": "{{user.profile.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.profile.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.school_id": "{{user.profile.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}