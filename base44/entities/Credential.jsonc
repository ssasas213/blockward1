{
  "name": "Credential",
  "type": "object",
  "properties": {
    "bw_id": {
      "type": "string",
      "description": "Public Blockward Credential ID (format BW-XXXXXXXX) \u2014 powers /verify/BW-XXXXXXXX. Unique; protected against duplicates."
    },
    "achievement_id": {
      "type": "string",
      "description": "Achievement.id this credential was issued for"
    },
    "org_id": {
      "type": "string",
      "description": "IssuerOrganisation.id that verified this credential (org flow) \u2014 powers the organisation dashboard's credential list and public issuer pages"
    },
    "holder_id": {
      "type": "string",
      "description": "UserProfile.id of the holder"
    },
    "holder_email": {
      "type": "string",
      "description": "Holder email \u2014 RLS anchor. NEVER public."
    },
    "holder_display_name": {
      "type": "string",
      "description": "Holder display name (public)"
    },
    "issuer_org": {
      "type": "string",
      "description": "Issuing organisation name (public)"
    },
    "issuer_org_handle": {
      "type": "string",
      "description": "IssuerOrganisation.handle (public) \u2014 links the credential to its issuer profile"
    },
    "issuer_website": {
      "type": "string",
      "description": "Issuer website (public, if available)"
    },
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [],
      "description": "PUBLIC snapshot of the authorised verifier(s) who signed \u2014 'Verified by John Smith, Mathematics Teacher, Dubai College'. Joint verification shows every signer. Written only by the issuance pipeline."
    },
    "title": {
      "type": "string",
      "description": "Achievement title \u2014 ATTESTED content of the credential"
    },
    "category": {
      "type": "string",
      "description": "Achievement type/category \u2014 ATTESTED content"
    },
    "description": {
      "type": "string",
      "description": "Achievement description \u2014 ATTESTED content (part of the BW-HASH-V1 commitment)"
    },
    "date_achieved": {
      "type": "string",
      "format": "date",
      "description": "Achievement date \u2014 ATTESTED content"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Expiry date if applicable (null = never expires)"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the issuer confirmed the achievement"
    },
    "verification_method": {
      "type": "string",
      "description": "How the issuer verified (e.g. reviewed_evidence) \u2014 public"
    },
    "verification_request_id": {
      "type": "string",
      "description": "VerificationRequest.id this credential was created from"
    },
    "schema_version": {
      "type": "number",
      "default": 1,
      "description": "Internal credential schema version"
    },
    "credential_hash": {
      "type": "string",
      "description": "SHA-256 BW-HASH-V1 content commitment captured at anchor time. Public verification recomputes the hash from current content and compares \u2014 any drift is a hash mismatch, never 'verified'."
    },
    "hash_version": {
      "type": "number",
      "default": 1,
      "description": "Credential hashing format version"
    },
    "anchor_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "confirmed",
        "failed"
      ],
      "default": "pending",
      "description": "Top-level anchoring lock state. 'pending' = in the Merkle batching queue (batch tracked via blockchain.batch_ref); 'confirmed' = anchored with an independently verifiable proof. Mirrored into blockchain.status. Service-role only."
    },
    "anchor_claimed_by": {
      "type": "string",
      "description": "Transient anchoring lock claim (uuid per attempt). Stale claims (>10 min) are taken over automatically. Service-role only."
    },
    "anchor_claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "blockchain": {
      "type": "object",
      "description": "Polygon PoS anchor record. Service-role only.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "processing",
            "confirmed",
            "failed"
          ],
          "default": "pending",
          "description": "Display status, mirrored from anchor_status"
        },
        "network": {
          "type": "string",
          "description": "e.g. polygon_amoy (testnet) or polygon (mainnet) \u2014 always labelled wherever displayed"
        },
        "chain_id": {
          "type": "number"
        },
        "anchor_mode": {
          "type": "string",
          "enum": [
            "contract",
            "calldata",
            "batch_calldata"
          ],
          "description": "contract = BlockwardRegistry contract anchor; calldata = per-credential commitment written as transaction input data (legacy BW-HASH-V1 path); batch_calldata = BATCH-PROOF-V1 \u2014 the credential's BW-HASH-V1 leaf is proven into a Merkle root anchored in one shared transaction"
        },
        "contract_address": {
          "type": "string"
        },
        "transaction_hash": {
          "type": "string"
        },
        "block_number": {
          "type": "number"
        },
        "block_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "type": "string",
          "description": "Reason for the last failed attempt (retryable)"
        },
        "queued_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the credential entered the Merkle batching queue."
        },
        "batch_ref": {
          "type": "string",
          "description": "AnchorBatch.batch_ref this credential is anchored within (batch_calldata mode)."
        },
        "batch_root": {
          "type": "string",
          "description": "BATCH-PROOF-V1 Merkle root committed on-chain for the containing batch."
        },
        "merkle_leaf_index": {
          "type": "number",
          "description": "This credential's leaf position in the batch Merkle tree."
        },
        "merkle_proof": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              },
              "hash": {
                "type": "string"
              }
            },
            "required": [
              "position",
              "hash"
            ]
          },
          "description": "BATCH-PROOF-V1 inclusion proof \u2014 sibling hashes from leaf to root. Independently verifiable against the on-chain batch root. Service-role only."
        }
      }
    },
    "chain_check": {
      "type": "object",
      "description": "Service-role-only verification result. Version 2 = hardened per-credential calldata check; version 1 (BATCH) = verified batch inclusion with matching content/anchor bindings. Both require a fresh checked_at to confer confirmed trust. Legacy caches require fresh verification.",
      "properties": {
        "verification_version": {
          "type": "number"
        },
        "credential_id": {
          "type": "string"
        },
        "credential_version": {
          "type": "number"
        },
        "hash_version": {
          "type": "number"
        },
        "transaction_hash": {
          "type": "string"
        },
        "chain_id": {
          "type": "number"
        },
        "network": {
          "type": "string"
        },
        "anchor_chain_id": {
          "type": "number"
        },
        "anchor_network": {
          "type": "string"
        },
        "anchor_mode": {
          "type": "string"
        },
        "contract_address": {
          "type": "string"
        },
        "batch_root": {
          "type": "string",
          "description": "BATCH-PROOF-V1: the verified Merkle root (also the on-chain committed value)."
        },
        "batch_member_count": {
          "type": "number",
          "description": "BATCH-PROOF-V1: number of credentials sharing the anchored root."
        },
        "merkle_leaf_index": {
          "type": "number",
          "description": "BATCH-PROOF-V1: verified leaf position."
        },
        "merkle_leaf": {
          "type": "string",
          "description": "BATCH-PROOF-V1: the verified BW-HASH-V1 leaf (recomputed from current content)."
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "hash_mismatch",
            "anchor_invalid",
            "chain_unavailable",
            "pending"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "committed_hash": {
          "type": "string"
        },
        "recomputed_hash": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Whether the public verification page is reachable. Integrity is still checked either way."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active",
      "description": "Current validity. Revocation never deletes the blockchain record."
    },
    "revocation": {
      "type": "object",
      "description": "Set by a Blockward admin when a credential is revoked. The on-chain anchor stays exactly as it was \u2014 the public page renders REVOKED. Service-role only.",
      "properties": {
        "reason": {
          "type": "string"
        },
        "revoked_by": {
          "type": "string"
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "event_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "description": "created | blockchain_queued | blockchain_started | blockchain_confirmed | blockchain_failed | revoked | integrity_mismatch"
          },
          "actor": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "event",
          "timestamp"
        ]
      },
      "default": [],
      "description": "Timestamped audit trail of this credential"
    }
  },
  "required": [
    "bw_id",
    "achievement_id",
    "holder_email",
    "title"
  ],
  "rls": {
    "create": {
      "data.bw_id": "__service_role_only__"
    },
    "read": {
      "$or": [
        {
          "data.holder_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.bw_id": "__service_role_only__"
    },
    "delete": {
      "data.bw_id": "__service_role_only__"
    }
  }
}