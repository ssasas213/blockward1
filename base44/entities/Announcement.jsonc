{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "School this announcement belongs to"
    },
    "title": {
      "type": "string",
      "description": "Announcement title"
    },
    "body": {
      "type": "string",
      "description": "Full announcement body"
    },
    "body_short": {
      "type": "string",
      "description": "Short version of the announcement"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "important",
        "urgent"
      ],
      "default": "normal",
      "description": "Urgency level"
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "SCHOOL",
        "YEAR_GROUP",
        "CLASS",
        "TEAM",
        "STUDENTS"
      ],
      "default": "SCHOOL",
      "description": "Who this announcement targets"
    },
    "year_group_id": {
      "type": "string"
    },
    "year_group_name": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "student_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "student_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sent"
      ],
      "default": "draft"
    },
    "created_by": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "body",
    "created_by"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.profile.school_id}}"
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.scope_type": "SCHOOL"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.student_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.profile.school_id}}",
      "user_condition": {
        "role": "admin"
      }
    }
  }
}