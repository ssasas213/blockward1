{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "School this announcement belongs to"
    },
    "title": {
      "type": "string",
      "description": "Announcement title"
    },
    "body": {
      "type": "string",
      "description": "Full announcement body"
    },
    "body_short": {
      "type": "string",
      "description": "Short version of the announcement"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "important",
        "urgent"
      ],
      "default": "normal",
      "description": "Urgency level"
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "SCHOOL",
        "YEAR_GROUP",
        "CLASS",
        "TEAM",
        "STUDENTS"
      ],
      "default": "SCHOOL",
      "description": "Who this announcement targets"
    },
    "year_group_id": {
      "type": "string"
    },
    "year_group_name": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "student_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "student_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sent"
      ],
      "default": "draft"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name of the attached file"
          },
          "url": {
            "type": "string",
            "description": "Uploaded file URL"
          },
          "file_type": {
            "type": "string",
            "enum": [
              "pdf",
              "document",
              "image",
              "video",
              "link",
              "other"
            ]
          }
        },
        "required": [
          "name",
          "url"
        ]
      },
      "default": [],
      "description": "Files attached to this announcement, shown on the class Stream post. Uploaded via the createAnnouncement flow."
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "Pinned to the top of the class Stream by the teacher. Only meaningful for CLASS-scoped announcements; set through the streamAction function."
    },
    "allow_comments": {
      "type": "boolean",
      "description": "Per-post override for Stream comments. null/undefined = follow the class setting (Class.allow_student_comments). true = comments open even if the class default is off. false = comments closed for this post regardless."
    },
    "created_by": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "body",
    "created_by"
  ],
  "rls": {
    "create": {
      "data.school_id": "__service_role_only__"
    },
    "read": {
      "$and": [
        {
          "data.school_id": "{{user.profile.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.scope_type": "SCHOOL"
            },
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.student_emails": {
                "$in": [
                  "{{user.email}}"
                ]
              }
            },
            {
              "data.class_id": {
                "$in": "{{user.data.class_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.profile.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.school_id": "{{user.profile.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}