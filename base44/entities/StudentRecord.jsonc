{
  "name": "StudentRecord",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "School this record belongs to \u2014 enforces data isolation"
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string",
      "description": "UserProfile.id of the reviewing teacher"
    },
    "teacher_email": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "teacher_signature_url": {
      "type": "string",
      "description": "URL of teacher's drawn digital signature image"
    },
    "teacher_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_id": {
      "type": "string",
      "description": "UserProfile.id of the signing admin"
    },
    "admin_email": {
      "type": "string"
    },
    "admin_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string",
      "description": "UserProfile.id of the student"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "academic",
        "sports",
        "arts",
        "leadership",
        "community",
        "behaviour",
        "special"
      ],
      "default": "academic"
    },
    "description": {
      "type": "string"
    },
    "date_achieved": {
      "type": "string",
      "format": "date",
      "description": "When the achievement occurred"
    },
    "award_type_id": {
      "type": "string",
      "description": "Reference to AwardTypes template (null if custom award)"
    },
    "award_type_title": {
      "type": "string",
      "description": "Original template title (for admin review)"
    },
    "is_custom_award": {
      "type": "boolean",
      "default": false,
      "description": "True if teacher created a custom award (not from template)"
    },
    "custom_award_icon": {
      "type": "string",
      "description": "Emoji icon for custom awards"
    },
    "custom_award_color": {
      "type": "string",
      "description": "Hex color for custom awards"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Points/value associated with this achievement"
    },
    "teacher_notes": {
      "type": "string",
      "description": "Notes from teacher to admin during approval review"
    },
    "file_url": {
      "type": "string",
      "description": "Student-uploaded evidence image or file (required)"
    },
    "file_type": {
      "type": "string"
    },
    "certificate_url": {
      "type": "string",
      "description": "Optional certificate or supporting document upload"
    },
    "custom_nft_image_url": {
      "type": "string",
      "description": "Optional custom NFT image uploaded by teacher for custom awards"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "awaiting_teacher_signature",
        "awaiting_admin_signature",
        "approved",
        "pending_student_drive",
        "minted",
        "archived",
        "rejected"
      ],
      "default": "draft",
      "description": "Workflow status"
    },
    "teacher_signed": {
      "type": "boolean",
      "default": false
    },
    "teacher_signature_id": {
      "type": "string",
      "description": "Reference to DigitalSignature record"
    },
    "teacher_rejection_reason": {
      "type": "string"
    },
    "admin_signed": {
      "type": "boolean",
      "default": false
    },
    "admin_signature_id": {
      "type": "string",
      "description": "Reference to DigitalSignature record"
    },
    "admin_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "nft_token_id": {
      "type": "string",
      "description": "NFT token ID after minting"
    },
    "nft_image_url": {
      "type": "string",
      "description": "Generated NFT badge image URL"
    },
    "nft_metadata": {
      "type": "object",
      "description": "Full NFT metadata JSON"
    },
    "nft_transaction_hash": {
      "type": "string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    },
    "drive_file_url": {
      "type": "string",
      "description": "Google Drive saved file URL"
    },
    "drive_file_id": {
      "type": "string"
    },
    "drive_folder_path": {
      "type": "string"
    },
    "drive_archive_destination": {
      "type": "string",
      "enum": [
        "student_drive",
        "school_drive",
        "admin_override"
      ],
      "description": "Which Drive was used for this archive"
    },
    "drive_connected_email": {
      "type": "string",
      "description": "Gmail account that owns the Drive where this was archived"
    },
    "override_reason": {
      "type": "string",
      "description": "Admin's reason for overriding to school Drive"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "verify_id": {
      "type": "string",
      "description": "Public verification ID for /verify/{verify_id}"
    }
  },
  "required": [
    "school_id",
    "student_email",
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "student"
          },
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.teacher_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "student"
          },
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "student"
          },
          "data.student_email": "{{user.email}}",
          "data.status": "draft"
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "student"
          },
          "data.student_email": "{{user.email}}",
          "data.status": "draft"
        }
      ]
    }
  }
}