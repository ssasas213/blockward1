{
  "name": "StudentRecord",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "School this record belongs to \u2014 enforces data isolation"
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string",
      "description": "UserProfile.id of the reviewing teacher"
    },
    "teacher_email": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "teacher_signature_url": {
      "type": "string",
      "description": "URL of teacher's drawn digital signature image"
    },
    "teacher_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_id": {
      "type": "string",
      "description": "UserProfile.id of the signing admin"
    },
    "admin_email": {
      "type": "string"
    },
    "admin_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string",
      "description": "UserProfile.id of the student"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "academic",
        "sports",
        "arts",
        "leadership",
        "community",
        "behaviour",
        "special"
      ],
      "default": "academic"
    },
    "description": {
      "type": "string"
    },
    "date_achieved": {
      "type": "string",
      "format": "date",
      "description": "When the achievement occurred"
    },
    "file_url": {
      "type": "string",
      "description": "Student-uploaded evidence image or file"
    },
    "file_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "awaiting_teacher_signature",
        "awaiting_admin_signature",
        "approved",
        "minted",
        "archived",
        "rejected"
      ],
      "default": "draft",
      "description": "Workflow status"
    },
    "teacher_signed": {
      "type": "boolean",
      "default": false
    },
    "teacher_signature_id": {
      "type": "string",
      "description": "Reference to DigitalSignature record"
    },
    "teacher_rejection_reason": {
      "type": "string"
    },
    "admin_signed": {
      "type": "boolean",
      "default": false
    },
    "admin_signature_id": {
      "type": "string",
      "description": "Reference to DigitalSignature record"
    },
    "admin_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "nft_token_id": {
      "type": "string",
      "description": "NFT token ID after minting"
    },
    "nft_image_url": {
      "type": "string",
      "description": "Generated NFT badge image URL"
    },
    "nft_metadata": {
      "type": "object",
      "description": "Full NFT metadata JSON"
    },
    "nft_transaction_hash": {
      "type": "string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    },
    "drive_file_url": {
      "type": "string",
      "description": "Google Drive saved file URL"
    },
    "drive_file_id": {
      "type": "string"
    },
    "drive_folder_path": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "verify_id": {
      "type": "string",
      "description": "Public verification ID for /verify/{verify_id}"
    }
  },
  "required": [
    "school_id",
    "student_email",
    "title",
    "category"
  ]
}