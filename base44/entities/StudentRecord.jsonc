{
  "name": "StudentRecord",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "School this record belongs to \u2014 enforces data isolation. NULL for independently verified records (the student has no organisation)."
    },
    "verification_mode": {
      "type": "string",
      "enum": [
        "organisation",
        "independent"
      ],
      "default": "organisation",
      "description": "How this achievement was verified: staff of a member organisation, or an independent named verifier via an account-free attestation link. Powers the distinct badge in the student's vault."
    },
    "independent_verifier": {
      "type": "object",
      "description": "Snapshot of the independent verifier for mode:'independent' records (name, role, free-text organisation label).",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "organisation_label": {
          "type": "string"
        }
      }
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string",
      "description": "UserProfile.id of the reviewing teacher"
    },
    "teacher_email": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "teacher_signature_url": {
      "type": "string",
      "description": "URL of teacher's drawn digital signature image"
    },
    "teacher_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_id": {
      "type": "string",
      "description": "UserProfile.id of the signing admin"
    },
    "admin_email": {
      "type": "string"
    },
    "admin_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string",
      "description": "UserProfile.id of the student"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "owner_student_id": {
      "type": "string",
      "description": "PERMANENT OWNER \u2014 UserProfile.id of the student. Survives teacher/admin departure."
    },
    "owner_student_email": {
      "type": "string",
      "description": "PERMANENT OWNER \u2014 student email. The student always owns this achievement."
    },
    "owner_school_id": {
      "type": "string",
      "description": "PERMANENT OWNER \u2014 school_id at time of creation. Immutable ownership anchor. NULL for independently verified records."
    },
    "origin": {
      "type": "string",
      "enum": [
        "student",
        "teacher"
      ],
      "description": "Who originally submitted the achievement. Determines the editor when changes are requested: student-submitted \u2192 student edits; teacher-issued \u2192 issuing teacher edits."
    },
    "title": {
      "type": "string",
      "description": "ATTESTED field \u2014 part of what the signers attested to. On a verified record it is immutable by direct edit; only an approved correction (a new version) may change it."
    },
    "category": {
      "type": "string",
      "enum": [
        "academic",
        "sports",
        "arts",
        "leadership",
        "community",
        "behaviour",
        "special"
      ],
      "default": "academic",
      "description": "ATTESTED field \u2014 see title."
    },
    "description": {
      "type": "string",
      "description": "ATTESTED field \u2014 see title."
    },
    "date_achieved": {
      "type": "string",
      "format": "date",
      "description": "ATTESTED field \u2014 see title."
    },
    "award_type_id": {
      "type": "string",
      "description": "Reference to AwardTypes template (null if custom award)"
    },
    "award_type_title": {
      "type": "string",
      "description": "Original template title (for admin review)"
    },
    "is_custom_award": {
      "type": "boolean",
      "default": false,
      "description": "True if teacher created a custom award (not from template)"
    },
    "custom_award_icon": {
      "type": "string",
      "description": "Emoji icon for custom awards"
    },
    "custom_award_color": {
      "type": "string",
      "description": "Hex color for custom awards"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Points/value associated with this achievement"
    },
    "teacher_notes": {
      "type": "string",
      "description": "Notes from teacher to admin during approval review"
    },
    "file_url": {
      "type": "string",
      "description": "Student-uploaded evidence image or file (required). ATTESTED field on a verified record \u2014 only an approved correction may change it."
    },
    "file_type": {
      "type": "string"
    },
    "certificate_url": {
      "type": "string",
      "description": "Optional certificate or supporting document upload"
    },
    "custom_nft_image_url": {
      "type": "string",
      "description": "PRESENTATION field \u2014 the student's public cover image. Never part of any attestation; the student may change it freely at any time, on any version."
    },
    "private_notes": {
      "type": "string",
      "description": "PRESENTATION field \u2014 the student's private notes about this achievement. Never shown publicly and never part of any attestation; editable freely at any time."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "awaiting_teacher_signature",
        "awaiting_admin_signature",
        "changes_requested",
        "approved",
        "delivering",
        "delivered_to_vault",
        "minted",
        "archived",
        "superseded",
        "rejected"
      ],
      "default": "draft",
      "description": "Workflow status. 'delivering' is a transient lock status set atomically during vault delivery to prevent concurrent duplicate BlockWards. 'superseded' \u2014 this version was replaced by an approved correction (superseded_by_id points at the newer version); it is retained permanently for the audit trail and excluded from vault listings. Set only by the correction flow (service role)."
    },
    "delivery_claimed_by": {
      "type": "string",
      "description": "Admin email that currently holds the delivery lock (transient, set during 'delivering' status)."
    },
    "delivery_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the delivery lock was claimed."
    },
    "changes_requested_reason": {
      "type": "string",
      "description": "Admin's message when requesting changes"
    },
    "changes_requested_by": {
      "type": "string",
      "description": "Email of the admin who requested changes"
    },
    "changes_requested_by_name": {
      "type": "string",
      "description": "Display name of the admin who requested changes"
    },
    "changes_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When changes were requested"
    },
    "resubmitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the record was resubmitted after changes"
    },
    "last_notified_status": {
      "type": "string",
      "description": "Idempotency marker \u2014 the last status a notification was dispatched for. Prevents duplicate notifications on retries."
    },
    "delivered_to_student_vault": {
      "type": "boolean",
      "default": false,
      "description": "True only after the achievement has been delivered to the student vault AND verified by re-query"
    },
    "teacher_signed": {
      "type": "boolean",
      "default": false
    },
    "teacher_signature_id": {
      "type": "string",
      "description": "Reference to DigitalSignature record"
    },
    "teacher_rejection_reason": {
      "type": "string"
    },
    "admin_signed": {
      "type": "boolean",
      "default": false
    },
    "admin_signature_id": {
      "type": "string",
      "description": "Reference to DigitalSignature record"
    },
    "admin_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "nft_token_id": {
      "type": "string",
      "description": "NFT token ID after minting"
    },
    "nft_image_url": {
      "type": "string",
      "description": "Generated NFT badge image URL"
    },
    "nft_metadata": {
      "type": "object",
      "description": "Full NFT metadata JSON"
    },
    "nft_transaction_hash": {
      "type": "string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "verify_id": {
      "type": "string",
      "description": "Public verification ID for /verify/{verify_id}"
    },
    "vault_status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered"
      ],
      "default": "pending",
      "description": "Whether this record has been delivered to the student vault"
    },
    "vault_delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the record was delivered to the student vault"
    },
    "vault_delivered_by": {
      "type": "string",
      "description": "Admin email who delivered to vault"
    },
    "blockward_id": {
      "type": "string",
      "description": "BlockWard.id created when delivered to vault"
    },
    "migrated_request_id": {
      "type": "string",
      "description": "AchievementRequest.id this legacy student submission was converted to by the one-time migration. The record itself is NOT deleted \u2014 it stays queryable as the source-of-truth history; review actions now happen on the request."
    },
    "migrated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this legacy student submission was converted to the achievement-request flow"
    },
    "deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft-delete flag \u2014 set by the duplicate-record cleanup. Deleted records are excluded from vault listings and public pages but kept for audit history. Service-role only."
    },
    "deleted_reason": {
      "type": "string",
      "description": "Why this record was soft-deleted, e.g. 'Duplicate of <record id> \u2014 soft-deleted by dedupe (same student, title, date_achieved)'."
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Credential version. 1 = originally verified content. An approved correction creates the next version as a NEW record (never overwriting) and marks this one superseded. Service-role only (correction flow)."
    },
    "previous_version_id": {
      "type": "string",
      "description": "StudentRecord.id of the version this one replaced \u2014 the immutable chain backwards. Service-role only."
    },
    "superseded_by_id": {
      "type": "string",
      "description": "StudentRecord.id of the approved-corrected version that replaced this one. The old version is retained permanently, never deleted. Service-role only."
    },
    "edit_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field that changed"
          },
          "old_value": {
            "description": "Value before the edit (stringified for storage)"
          },
          "new_value": {
            "description": "Value after the edit (stringified for storage)"
          },
          "edited_by": {
            "type": "string",
            "description": "Email of the actor who made the edit"
          },
          "edited_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "description": "Why the edit was made (student's correction reason or 'presentation edit')"
          }
        },
        "required": [
          "field",
          "edited_at"
        ]
      },
      "default": [],
      "description": "Every edit to this credential, with actor, old and new values and reason. Service-role only (credentialEditAction)."
    },
    "correction_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "declined"
      ],
      "default": "none",
      "description": "Correction-request state for an attested (verified) credential. 'pending' \u2014 the student proposed a correction to attested fields and the original verifier (or an org admin) must re-sign it. 'approved' \u2014 a newer version superseded this one. 'declined' \u2014 the reviewer declined; attested content unchanged. Service-role only."
    },
    "correction_proposed": {
      "type": "object",
      "description": "The proposed attested values while a correction is pending. Service-role only.",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date_achieved": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      }
    },
    "correction_reason": {
      "type": "string",
      "description": "The student's explanation of what is wrong and why the correction is needed. Required to open a correction. Service-role only."
    },
    "correction_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the student opened the correction request. Service-role only."
    },
    "correction_requested_by": {
      "type": "string",
      "description": "Email of the student who requested the correction. Service-role only."
    },
    "correction_approved_by": {
      "type": "string",
      "description": "Email of the verifier who re-signed the corrected version (or declined it). Service-role only."
    },
    "correction_declined_reason": {
      "type": "string",
      "description": "Reviewer's reason for declining the correction. Service-role only."
    },
    "corrected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the approved correction took effect (version N+1 created). Shown publicly as 'Corrected on <date>'. Service-role only."
    }
  },
  "required": [
    "student_email",
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "data.school_id": "__service_role_only__"
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.owner_student_email": "{{user.email}}"
        },
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "data.school_id": "__service_role_only__"
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.student_email": "{{user.email}}"
            },
            {
              "data.status": "draft"
            }
          ]
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}