{
  "name": "JoinRequest",
  "type": "object",
  "properties": {
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "class_id",
    "student_email"
  ],
  "rls": {
    "create": {
      "data.student_email": "{{user.email}}",
      "data.school_id": "{{user.profile.school_id}}"
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.class_id": {
            "$in": "{{user.profile.class_ids}}"
          }
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          },
          "data.class_id": {
            "$in": "{{user.profile.class_ids}}"
          }
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.profile.school_id}}",
      "user_condition": {
        "role": "admin"
      }
    }
  }
}