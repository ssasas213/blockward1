{
  "name": "VerificationRequest",
  "type": "object",
  "properties": {
    "achievement_id": {
      "type": "string",
      "description": "Achievement.id this request is for"
    },
    "holder_id": {
      "type": "string",
      "description": "UserProfile.id of the requesting holder"
    },
    "holder_email": {
      "type": "string",
      "description": "Holder email"
    },
    "holder_name": {
      "type": "string",
      "description": "Denormalised holder display name"
    },
    "achievement_title": {
      "type": "string",
      "description": "Denormalised achievement title (snapshot at request time)"
    },
    "issuer_org": {
      "type": "string",
      "description": "Issuing organisation name"
    },
    "issuer_contact_name": {
      "type": "string",
      "description": "Issuer contact name if known"
    },
    "issuer_email": {
      "type": "string",
      "description": "Issuer email \u2014 the verification link is sent here (token flow)"
    },
    "issuer_website": {
      "type": "string",
      "description": "Issuer website if available"
    },
    "org_id": {
      "type": "string",
      "description": "IssuerOrganisation.id \u2014 set when the request was sent to a registered Issuer Organisation (org flow). Null for the legacy token-email flow."
    },
    "org_name": {
      "type": "string",
      "description": "Denormalised IssuerOrganisation name"
    },
    "org_handle": {
      "type": "string",
      "description": "Denormalised IssuerOrganisation handle for public links"
    },
    "org_logo_url": {
      "type": "string",
      "description": "Denormalised organisation logo"
    },
    "policy_id": {
      "type": "string",
      "description": "VerificationPolicy.id applied to this request"
    },
    "required_signatures": {
      "type": "number",
      "default": 1,
      "description": "Verifier signatures needed before issuer verification is complete (from the applied policy; 1 = single, 2+ = joint)"
    },
    "signature_count": {
      "type": "number",
      "default": 0,
      "description": "Signatures received so far \u2014 incremented by orgVerificationReview; issuer verification completes only at required_signatures"
    },
    "token": {
      "type": "string",
      "description": "Secure random one-time verification token \u2014 the ONLY way to act on this request in the token flow. Never expose the database id."
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the verification link expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "opened",
        "approved",
        "rejected",
        "expired",
        "withdrawn"
      ],
      "default": "pending",
      "description": "pending = awaiting the issuer. opened = viewed (still actionable). approved/rejected = terminal. expired = token window passed. withdrawn = holder cancelled before response."
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "First time the issuer opened the request"
    },
    "open_count": {
      "type": "number",
      "default": 0,
      "description": "How many times the request has been opened"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the issuer responded"
    },
    "decision": {
      "type": "string",
      "enum": [
        "confirmed",
        "cannot_verify"
      ],
      "description": "The issuer's decision"
    },
    "decision_reason": {
      "type": "string",
      "description": "Optional reason when the issuer cannot verify"
    },
    "decision_method": {
      "type": "string",
      "enum": [
        "witnessed_in_person",
        "reviewed_evidence",
        "official_records",
        "third_party",
        "other"
      ],
      "description": "How the issuer verified \u2014 recorded for the public verification page"
    },
    "decision_note": {
      "type": "string",
      "description": "Optional free-text note from the issuer"
    },
    "decision_ip": {
      "type": "string",
      "description": "IP the decision was submitted from (audit trail)"
    },
    "decision_user_agent": {
      "type": "string",
      "description": "Browser user agent at decision time (audit trail)"
    },
    "email_status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "pending"
      ],
      "description": "Outcome of the last verification email attempt"
    },
    "email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "reminder_count": {
      "type": "number",
      "default": 0
    },
    "last_reminder_at": {
      "type": "string",
      "format": "date-time",
      "description": "Anchors the resend cooldown"
    },
    "event_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "description": "created | email_sent | email_failed | opened | confirmed | declined | reminded | expired | withdrawn | signed | threshold_reached | additional_signature_requested"
          },
          "actor": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "event",
          "timestamp"
        ]
      },
      "default": [],
      "description": "Timestamped audit trail of this verification request"
    }
  },
  "required": [
    "achievement_id",
    "holder_email",
    "issuer_email",
    "token"
  ],
  "rls": {
    "create": {
      "data.achievement_id": "__service_role_only__"
    },
    "read": {
      "data.holder_email": "{{user.email}}"
    },
    "update": {
      "data.achievement_id": "__service_role_only__"
    },
    "delete": {
      "data.achievement_id": "__service_role_only__"
    }
  }
}