{
  "name": "DriveVault",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Student who owns this vault"
    },
    "record_id": {
      "type": "string",
      "description": "StudentRecord.id"
    },
    "school_id": {
      "type": "string"
    },
    "drive_file_id": {
      "type": "string"
    },
    "drive_folder_path": {
      "type": "string"
    },
    "drive_url": {
      "type": "string"
    },
    "metadata_file_id": {
      "type": "string"
    },
    "certificate_file_id": {
      "type": "string"
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "failed"
      ],
      "default": "saved"
    },
    "connected_google_email": {
      "type": "string",
      "description": "The Gmail account that owns the Drive where the file was saved"
    },
    "drive_owner_user_id": {
      "type": "string",
      "description": "Base44 user ID of the Drive owner (student or admin)"
    },
    "archive_destination": {
      "type": "string",
      "enum": [
        "student_drive",
        "school_drive",
        "admin_override"
      ],
      "default": "student_drive",
      "description": "Which Google Drive was used for this archive"
    }
  },
  "required": [
    "student_email",
    "record_id",
    "school_id"
  ],
  "rls": {
    "create": {
      "data.school_id": "__service_role_only__"
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    }
  }
}