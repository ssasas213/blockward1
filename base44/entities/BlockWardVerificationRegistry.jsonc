{
  "name": "BlockWardVerificationRegistry",
  "type": "object",
  "properties": {
    "verification_id": {
      "type": "string",
      "description": "Permanent public verification ID (format: BW-2026-ABCD1234). Powers /verify/{verification_id}. Stable across corrections \u2014 a correction never changes the public URL, only the version shown."
    },
    "public_slug": {
      "type": "string",
      "description": "Human-readable URL slug for the verification page"
    },
    "blockward_id": {
      "type": "string",
      "description": "Foreign key to BlockWard.id"
    },
    "student_record_id": {
      "type": "string",
      "description": "Foreign key to StudentRecord.id \u2014 the CURRENT version's source-of-truth achievement. A correction updates this pointer to the new version (the old record is retained, superseded)."
    },
    "verification_mode": {
      "type": "string",
      "enum": [
        "organisation",
        "independent"
      ],
      "default": "organisation",
      "description": "HOW this credential was verified. 'organisation': signed by staff of a BlockWard member organisation. 'independent': signed by a named person outside the BlockWard network (coach, referee, employer\u2026) via an account-free attestation link. The two tiers MUST render distinctly \u2014 'Verified by <Organisation>' vs 'Verified by <Name>, <Role> at <Org label>' \u2014 so an independently verified credential can never be mistaken for an institutionally verified one."
    },
    "independent_verifier": {
      "type": "object",
      "description": "Snapshot of the independent verifier for mode:'independent' credentials \u2014 powers the 'Verified by <Name>, <Role> at <Organisation>' badge.",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "organisation_label": {
          "type": "string",
          "description": "Their organisation as free text (display label, not a BlockWard organisation)"
        }
      }
    },
    "organisation_id": {
      "type": "string",
      "description": "ID of the issuing organisation (School.id for schools)"
    },
    "organisation_type": {
      "type": "string",
      "enum": [
        "school",
        "university",
        "sports_club",
        "martial_arts_academy",
        "chess_organisation",
        "esports_organisation",
        "music_academy",
        "training_centre",
        "corporate_organisation",
        "community_organisation",
        "other"
      ],
      "default": "school",
      "description": "Type of issuing organisation"
    },
    "organisation_name": {
      "type": "string",
      "description": "Display name of the issuing organisation. For independently verified credentials this is the verifier's free-text organisation label (display only)."
    },
    "school_id": {
      "type": "string",
      "description": "School ID if organisation type is school"
    },
    "student_id": {
      "type": "string",
      "description": "UserProfile.id of the student (permanent owner)"
    },
    "student_name": {
      "type": "string",
      "description": "Display name of the student (public)"
    },
    "student_email": {
      "type": "string",
      "description": "Student email (PRIVATE \u2014 never exposed on public page). Also keys team credentials minted before the student joined BlockWard."
    },
    "achievement_title": {
      "type": "string",
      "description": "ATTESTED content of the CURRENT version \u2014 updated only when a correction is approved by the original verifier. Service-role only."
    },
    "achievement_category": {
      "type": "string",
      "enum": [
        "academic",
        "sports",
        "arts",
        "leadership",
        "community",
        "behaviour",
        "special"
      ],
      "default": "academic"
    },
    "achievement_description": {
      "type": "string",
      "description": "ATTESTED content of the current version \u2014 see achievement_title."
    },
    "achievement_image": {
      "type": "string",
      "description": "PRESENTATION field \u2014 the student's public cover image. Never part of any attestation; the student may change it freely at any time. Moderated before it becomes public; organisation admins can remove it."
    },
    "evidence_file_url": {
      "type": "string",
      "description": "Student-uploaded evidence file URL (shown only if is_public)"
    },
    "date_achieved": {
      "type": "string",
      "format": "date"
    },
    "date_approved": {
      "type": "string",
      "format": "date-time"
    },
    "date_delivered": {
      "type": "string",
      "format": "date-time"
    },
    "teacher_id": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string",
      "description": "Teacher/verifier display name (public). For independently verified credentials this is the independent verifier's name."
    },
    "teacher_signature_id": {
      "type": "string",
      "description": "Foreign key to DigitalSignature.id"
    },
    "admin_id": {
      "type": "string"
    },
    "admin_name": {
      "type": "string",
      "description": "Admin/authoriser display name (public)"
    },
    "admin_signature_id": {
      "type": "string",
      "description": "Foreign key to DigitalSignature.id"
    },
    "student_requested": {
      "type": "boolean",
      "default": false,
      "description": "True when this credential originated from a student achievement request rather than a staff-issued award. Shown on the public credential page."
    },
    "signer_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "e.g. Nominated verifier, Organisation admin, External verifier"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "witnessed_in_person",
              "reviewed_evidence",
              "official_records",
              "third_party",
              "other"
            ]
          },
          "method_note": {
            "type": "string"
          },
          "attestation": {
            "type": "boolean"
          },
          "ip_country": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "role",
          "timestamp"
        ]
      },
      "default": [],
      "description": "Full chain of signers for student-requested credentials \u2014 each signer's role, verification method, attestation and timestamp. A correction approval appends the re-signing entry. Displayed on the credential detail page and the per-achievement share card."
    },
    "is_team_credential": {
      "type": "boolean",
      "default": false,
      "description": "True when this personal credential belongs to a group achievement \u2014 links to the shared team record via team_slug."
    },
    "team_slug": {
      "type": "string",
      "description": "Slug of the shared team credential page (/team/:slug) when this is a team achievement"
    },
    "participant_role": {
      "type": "string",
      "description": "This participant's role in the team achievement (captain, striker, lead developer, first board, designer\u2026)"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "approved",
        "revoked"
      ],
      "default": "approved"
    },
    "vault_status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered"
      ],
      "default": "delivered"
    },
    "nft_status": {
      "type": "string",
      "enum": [
        "pending",
        "minted",
        "failed"
      ],
      "default": "pending"
    },
    "blockchain_network": {
      "type": "string",
      "description": "e.g. sepolia, amoy, polygon"
    },
    "contract_address": {
      "type": "string",
      "description": "Anchor of the CURRENT version. When a correction is approved the previous version's anchor is snapshotted into previous_anchor (never mutated) and this field awaits the new version's anchor."
    },
    "token_id": {
      "type": "string",
      "description": "Anchor of the CURRENT version \u2014 see contract_address."
    },
    "transaction_hash": {
      "type": "string",
      "description": "Anchor of the CURRENT version \u2014 see contract_address."
    },
    "previous_anchor": {
      "type": "object",
      "description": "Snapshot of the PREVIOUS version's blockchain anchor, captured when a correction is approved. Anchors are never mutated \u2014 a superseded version's on-chain record stays exactly as it was minted. Service-role only.",
      "properties": {
        "version": {
          "type": "number",
          "description": "The version this anchor belonged to"
        },
        "blockward_id": {
          "type": "string"
        },
        "token_id": {
          "type": "string"
        },
        "transaction_hash": {
          "type": "string"
        },
        "contract_address": {
          "type": "string"
        },
        "blockchain_network": {
          "type": "string"
        },
        "anchored_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Credential version currently shown on the public verification page. Bumped only by an approved correction. Service-role only (correction flow)."
    },
    "corrected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current version's correction was approved \u2014 rendered publicly as 'Corrected on <date>'. Service-role only."
    },
    "correction_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "description": "The version this correction produced"
          },
          "corrected_at": {
            "type": "string",
            "format": "date-time"
          },
          "approved_by": {
            "type": "string",
            "description": "Display name of the verifier who re-signed the corrected version"
          },
          "reason": {
            "type": "string",
            "description": "The student's reason for the correction"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "old_value": {
                  "description": "Stringified value before the correction"
                },
                "new_value": {
                  "description": "Stringified value after the correction"
                }
              },
              "required": [
                "field"
              ]
            }
          }
        },
        "required": [
          "version",
          "corrected_at"
        ]
      },
      "default": [],
      "description": "Transparent version history \u2014 every approved correction with who re-signed it and exactly what changed. Shown on the public verification page. Service-role only."
    },
    "certificate_url": {
      "type": "string",
      "description": "Optional certificate download URL (public)"
    },
    "metadata_url": {
      "type": "string",
      "description": "IPFS metadata URI for NFT"
    },
    "public_verification_url": {
      "type": "string",
      "description": "Full public verification URL"
    },
    "share_card_url": {
      "type": "string",
      "description": "Server-generated 1080x1080 share card PNG (achievement variant) \u2014 issued org, date, signer chain and verify QR. Rendered by generateProfileCard."
    },
    "share_card_hash": {
      "type": "string",
      "description": "Cache validity hash for the share card \u2014 a change to the credential's card content triggers regeneration on next request."
    },
    "share_story_card_url": {
      "type": "string",
      "description": "Server-rendered 1080x1920 story share card PNG (achievement variant, 9:16 format). Rendered by generateProfileCard."
    },
    "share_story_card_hash": {
      "type": "string",
      "description": "Cache validity hash for the 9:16 story share card."
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Whether this record is visible on the public verification page"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "link_only",
        "private"
      ],
      "default": "public",
      "description": "PRESENTATION field \u2014 student-set visibility on the public /@handle profile grid. Never part of any attestation; the student may change it freely at any time. Set through updatePublicProfile / credentialEditAction (registry writes are service-role only)."
    }
  },
  "required": [
    "verification_id",
    "student_record_id",
    "achievement_title",
    "achievement_category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}