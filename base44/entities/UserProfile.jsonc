{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Links to User entity"
    },
    "school_id": {
      "type": "string",
      "description": "Currently active school \u2014 used by RLS for data isolation. Updated when admin switches schools."
    },
    "active_school_id": {
      "type": "string",
      "description": "Explicit active school ID. Mirrors school_id for UI clarity and multi-school switching."
    },
    "user_type": {
      "type": "string",
      "enum": [
        "admin",
        "teacher",
        "student"
      ],
      "description": "Core role: admin=Approver/Org Admin, teacher=Verifier, student=Participant"
    },
    "role_label": {
      "type": "string",
      "description": "Custom display label for this user's role"
    },
    "admin_level": {
      "type": "string",
      "enum": [
        "super_admin",
        "head_of_year",
        "head_of_department",
        "data_manager",
        "basic_admin"
      ],
      "description": "Access level for admin users"
    },
    "admin_permissions": {
      "type": "object",
      "description": "Granular permissions for admins",
      "properties": {
        "manage_users": {
          "type": "boolean",
          "default": false
        },
        "manage_classes": {
          "type": "boolean",
          "default": false
        },
        "issue_blockwards": {
          "type": "boolean",
          "default": false
        },
        "view_all_points": {
          "type": "boolean",
          "default": false
        },
        "edit_points": {
          "type": "boolean",
          "default": false
        },
        "view_reports": {
          "type": "boolean",
          "default": false
        },
        "manage_categories": {
          "type": "boolean",
          "default": false
        },
        "manage_school_settings": {
          "type": "boolean",
          "default": false
        },
        "view_parent_contacts": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "default": "system",
      "description": "User's preferred UI theme"
    },
    "student_id": {
      "type": "string",
      "description": "Student ID number (for students)"
    },
    "grade_level": {
      "type": "string",
      "description": "Year/Grade level (for students)"
    },
    "department": {
      "type": "string",
      "description": "Department (for teachers)"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Subjects taught (for teachers)"
    },
    "admin_email": {
      "type": "string",
      "description": "School admin email \u2014 inherited by teachers and students"
    },
    "primary_teacher_email": {
      "type": "string",
      "description": "Primary teacher email \u2014 inherited by students"
    },
    "parent_name": {
      "type": "string",
      "description": "Parent/Guardian name (for students)"
    },
    "parent_email": {
      "type": "string",
      "description": "Parent/Guardian email (for students)"
    },
    "parent_phone": {
      "type": "string",
      "description": "Parent/Guardian phone (for students)"
    },
    "parent_relationship": {
      "type": "string",
      "enum": [
        "mother",
        "father",
        "guardian",
        "other"
      ],
      "description": "Relationship of parent/guardian to student"
    },
    "parent_contact_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "wallet_address": {
      "type": "string",
      "description": "Custodial blockchain wallet address"
    },
    "wallet_private_key_encrypted": {
      "type": "string",
      "description": "Encrypted private key (server-side only)"
    },
    "portfolio_public_id": {
      "type": "string",
      "description": "Public identifier for the student's shareable portfolio (format: prt-xxxxxxxx)."
    },
    "blockchain_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "TEACHER",
        "STUDENT"
      ],
      "description": "On-chain role"
    },
    "can_issue_blockwards": {
      "type": "boolean",
      "default": true
    },
    "total_achievement_points": {
      "type": "number",
      "default": 0
    },
    "total_behaviour_points": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "pending_approval"
      ],
      "default": "active"
    },
    "test_super_user": {
      "type": "boolean",
      "default": false,
      "description": "True only for the server-authorised test super user (the controller). Source of truth is the TEST_SUPER_USER_EMAIL secret; this flag is a cache set by getTestModeStatus."
    },
    "active_test_persona": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "admin"
      ],
      "description": "For the test super user only \u2014 which persona's experience is currently active. Read server-side by resolveEffectiveActor; never trusted from frontend input."
    },
    "test_persona_ids": {
      "type": "object",
      "description": "For the test super user only \u2014 maps persona role \u2192 UserProfile.id of the corresponding test persona profile. Set by getTestModeStatus.",
      "properties": {
        "student": {
          "type": "string"
        },
        "teacher": {
          "type": "string"
        },
        "admin": {
          "type": "string"
        }
      }
    },
    "test_persona_of": {
      "type": "string",
      "description": "For test persona profiles only \u2014 the controller email that owns this persona. Null for normal users and the controller itself."
    }
  },
  "required": [
    "user_email",
    "user_type",
    "first_name",
    "last_name"
  ]
}