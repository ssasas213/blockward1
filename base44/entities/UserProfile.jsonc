{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Links to User entity"
    },
    "school_id": {
      "type": "string",
      "description": "Currently active school \u2014 used by RLS for data isolation. Updated when admin switches schools."
    },
    "active_school_id": {
      "type": "string",
      "description": "Explicit active school ID. Mirrors school_id for UI clarity and multi-school switching."
    },
    "user_type": {
      "type": "string",
      "enum": [
        "admin",
        "teacher",
        "student"
      ],
      "description": "Core role: admin=Approver/Org Admin, teacher=Verifier, student=Participant"
    },
    "role_label": {
      "type": "string",
      "description": "Custom display label for this user's role"
    },
    "admin_level": {
      "type": "string",
      "enum": [
        "super_admin",
        "head_of_year",
        "head_of_department",
        "data_manager",
        "basic_admin"
      ],
      "description": "Display label that seeds default admin_permissions on creation."
    },
    "admin_permissions": {
      "type": "object",
      "description": "Source of truth for what this admin may do. Seeded from admin_level on creation, then editable per-admin.",
      "properties": {
        "manage_users": {
          "type": "boolean",
          "default": false
        },
        "manage_classes": {
          "type": "boolean",
          "default": false
        },
        "view_all_points": {
          "type": "boolean",
          "default": false
        },
        "edit_points": {
          "type": "boolean",
          "default": false
        },
        "view_reports": {
          "type": "boolean",
          "default": false
        },
        "manage_categories": {
          "type": "boolean",
          "default": false
        },
        "manage_school_settings": {
          "type": "boolean",
          "default": false
        },
        "view_parent_contacts": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "default": "system",
      "description": "User's preferred UI theme"
    },
    "show_mascot_on_signin": {
      "type": "boolean",
      "default": false,
      "description": "When true, the BlockWard mascot tour launches automatically on each sign-in (once per browser session)."
    },
    "class_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Class IDs this user is associated with \u2014 teachers: classes they teach (mirrored from StaffMembership); students: classes they're enrolled in (mirrored from Enrollment). Used by RLS for class-scoped reads on Enrollment/JoinRequest/Resource/TimetableEntry. Kept in sync by joinClassByCode + class creation."
    },
    "student_id": {
      "type": "string",
      "description": "Student ID number (for students)"
    },
    "grade_level": {
      "type": "string",
      "description": "Year/Grade level (for students)"
    },
    "department": {
      "type": "string",
      "description": "Department (for teachers)"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Subjects taught (for teachers)"
    },
    "admin_email": {
      "type": "string",
      "description": "School admin email \u2014 inherited by teachers and students"
    },
    "primary_teacher_email": {
      "type": "string",
      "description": "Primary teacher email \u2014 inherited by students"
    },
    "parent_name": {
      "type": "string",
      "description": "Parent/Guardian name (for students)"
    },
    "parent_email": {
      "type": "string",
      "description": "Parent/Guardian email (for students)"
    },
    "parent_phone": {
      "type": "string",
      "description": "Parent/Guardian phone (for students)"
    },
    "parent_relationship": {
      "type": "string",
      "enum": [
        "mother",
        "father",
        "guardian",
        "other"
      ],
      "description": "Relationship of parent/guardian to student"
    },
    "parent_contact_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "wallet_address": {
      "type": "string",
      "description": "Custodial blockchain wallet address (public). Private key lives on Vaults, never here."
    },
    "portfolio_public_id": {
      "type": "string",
      "description": "Public identifier for the student's shareable portfolio (format: prt-xxxxxxxx)."
    },
    "blockchain_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "TEACHER",
        "STUDENT"
      ],
      "description": "On-chain role"
    },
    "can_issue_blockwards": {
      "type": "boolean",
      "default": true
    },
    "total_achievement_points": {
      "type": "number",
      "default": 0
    },
    "total_behaviour_points": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "pending_approval"
      ],
      "default": "active"
    },
    "test_super_user": {
      "type": "boolean",
      "default": false,
      "description": "True only for the server-authorised test super user. Source of truth is the TEST_SUPER_USER_EMAIL secret."
    },
    "active_test_persona": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "admin"
      ],
      "description": "For the test super user only \u2014 which persona's experience is currently active."
    },
    "test_persona_ids": {
      "type": "object",
      "description": "For the test super user only \u2014 maps persona role \u2192 UserProfile.id of the corresponding test persona profile.",
      "properties": {
        "student": {
          "type": "string"
        },
        "teacher": {
          "type": "string"
        },
        "admin": {
          "type": "string"
        }
      }
    },
    "test_persona_of": {
      "type": "string",
      "description": "For test persona profiles only \u2014 the controller email that owns this persona."
    }
  },
  "required": [
    "user_email",
    "user_type",
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "data.school_id": "__service_role_only__"
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}