{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Links to User entity"
    },
    "school_id": {
      "type": "string",
      "description": "Currently active school \u2014 used by RLS for data isolation. Service-role only: clients can never write this field."
    },
    "active_school_id": {
      "type": "string",
      "description": "Explicit active school ID. Mirrors school_id for UI clarity and multi-school switching."
    },
    "user_type": {
      "type": "string",
      "enum": [
        "admin",
        "teacher",
        "student",
        "pending"
      ],
      "description": "Core role. 'pending' = provisioned account with no school yet. Service-role only: clients can never write this field."
    },
    "role_label": {
      "type": "string",
      "description": "Custom display label for this user's role"
    },
    "admin_level": {
      "type": "string",
      "enum": [
        "super_admin",
        "head_of_year",
        "head_of_department",
        "data_manager",
        "basic_admin"
      ],
      "description": "Seeds default admin_permissions. Service-role only."
    },
    "admin_permissions": {
      "type": "object",
      "description": "What this admin may do. Service-role only.",
      "properties": {
        "manage_users": {
          "type": "boolean",
          "default": false
        },
        "manage_classes": {
          "type": "boolean",
          "default": false
        },
        "view_all_points": {
          "type": "boolean",
          "default": false
        },
        "edit_points": {
          "type": "boolean",
          "default": false
        },
        "view_reports": {
          "type": "boolean",
          "default": false
        },
        "manage_categories": {
          "type": "boolean",
          "default": false
        },
        "manage_school_settings": {
          "type": "boolean",
          "default": false
        },
        "view_parent_contacts": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "handle": {
      "type": "string",
      "description": "Globally unique public handle for /@handle. Uniqueness enforced server-side."
    },
    "handle_history": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Previous handles kept permanently reserved."
    },
    "handle_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the handle was last claimed/changed \u2014 30-day cooldown anchor."
    },
    "bio": {
      "type": "string",
      "description": "Public bio shown on the public profile (max 200 characters, plain text, line breaks allowed)."
    },
    "pinned_achievement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Up to 6 registry ids pinned as Highlights."
    },
    "profile_visibility": {
      "type": "string",
      "enum": [
        "public",
        "link_only",
        "private"
      ],
      "default": "public",
      "description": "Global visibility of the public profile page."
    },
    "leaderboard_opt_out": {
      "type": "boolean",
      "default": false,
      "description": "Hidden from organisation leaderboards when true."
    },
    "og_image_url": {
      "type": "string",
      "description": "Generated 1200x630 share card used as the Open Graph image \u2014 server-rendered by generateProfileCard (variant 'og'), cached and regenerated on profile changes."
    },
    "story_card_url": {
      "type": "string",
      "description": "Generated 1080x1920 story card (Instagram/TikTok) \u2014 server-rendered by generateProfileCard, cached."
    },
    "feed_card_url": {
      "type": "string",
      "description": "Generated 1080x1080 feed card \u2014 server-rendered by generateProfileCard, cached."
    },
    "card_hashes": {
      "type": "object",
      "description": "Cache validity hashes per generated card variant \u2014 content changes (name, avatar, bio, theme, pins, count) produce a new hash and trigger regeneration on next request. Service-managed.",
      "properties": {
        "og": {
          "type": "string"
        },
        "story": {
          "type": "string"
        },
        "square": {
          "type": "string"
        }
      }
    },
    "theme_id": {
      "type": "string",
      "default": "slate",
      "description": "Named profile theme preset used by the public profile and share cards."
    },
    "accent_colour": {
      "type": "string",
      "description": "Accent colour (hex) from the fixed palette \u2014 overrides the theme's default accent on the profile and share cards."
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "default": "system",
      "description": "User's preferred UI theme"
    },
    "show_mascot_on_signin": {
      "type": "boolean",
      "default": false,
      "description": "Mascot tour launches automatically on sign-in when true."
    },
    "class_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Class IDs this user is associated with (teachers: taught; students: enrolled)."
    },
    "student_id": {
      "type": "string",
      "description": "Student ID number"
    },
    "grade_level": {
      "type": "string",
      "description": "Year/Grade level"
    },
    "department": {
      "type": "string",
      "description": "Department (teachers)"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Subjects taught (teachers)"
    },
    "admin_email": {
      "type": "string",
      "description": "School admin email \u2014 inherited"
    },
    "primary_teacher_email": {
      "type": "string",
      "description": "Primary teacher email \u2014 inherited"
    },
    "parent_name": {
      "type": "string",
      "description": "Parent/Guardian name"
    },
    "parent_email": {
      "type": "string",
      "description": "Parent/Guardian email. Doubles as the guardian email for under-13 consent."
    },
    "parent_phone": {
      "type": "string",
      "description": "Parent/Guardian phone"
    },
    "parent_relationship": {
      "type": "string",
      "enum": [
        "mother",
        "father",
        "guardian",
        "other"
      ],
      "description": "Relationship of parent/guardian to student"
    },
    "parent_contact_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Collected at signup for age-appropriate privacy/consent rules. Age derived server-side, never displayed publicly. Service-role only."
    },
    "default_credential_visibility": {
      "type": "string",
      "enum": [
        "public",
        "link_only"
      ],
      "default": "public",
      "description": "Age-derived safe default for new credentials. Service-role only."
    },
    "guardian_consent": {
      "type": "object",
      "description": "Under-13 consent record. Service-role only.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "granted"
          ]
        },
        "guardian_email": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "granted_at": {
          "type": "string",
          "format": "date-time",
          "description": "Compliance timestamp."
        },
        "granted_via": {
          "type": "string"
        }
      }
    },
    "guardian_consent_token": {
      "type": "string",
      "description": "One-time token for /guardian-consent/:token. Service-role only."
    },
    "wallet_address": {
      "type": "string",
      "description": "Custodial wallet address (public)."
    },
    "portfolio_public_id": {
      "type": "string",
      "description": "Public portfolio identifier (prt-xxxxxxxx)."
    },
    "blockchain_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "TEACHER",
        "STUDENT"
      ],
      "description": "On-chain role"
    },
    "can_issue_blockwards": {
      "type": "boolean",
      "default": true
    },
    "total_achievement_points": {
      "type": "number",
      "default": 0
    },
    "total_behaviour_points": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "pending_approval",
        "awaiting_guardian_consent"
      ],
      "default": "active",
      "description": "pending_approval: teacher awaiting admin approval. awaiting_guardian_consent: under-13 account inactive until guardian consents. Service-role only."
    },
    "test_super_user": {
      "type": "boolean",
      "default": false,
      "description": "True only for the server-authorised test super user."
    },
    "active_test_persona": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "admin"
      ],
      "description": "Test super user only \u2014 active persona."
    },
    "test_persona_ids": {
      "type": "object",
      "description": "Test super user only \u2014 persona role \u2192 profile id.",
      "properties": {
        "student": {
          "type": "string"
        },
        "teacher": {
          "type": "string"
        },
        "admin": {
          "type": "string"
        }
      }
    },
    "test_persona_of": {
      "type": "string",
      "description": "Test persona profiles only \u2014 owning controller email."
    }
  },
  "required": [
    "user_email",
    "user_type",
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {
      "data.user_email": "__service_role_only__"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "data.school_id": "__service_role_only__",
      "data.user_type": "__service_role_only__",
      "data.admin_level": "__service_role_only__",
      "data.admin_permissions": "__service_role_only__",
      "data.status": "__service_role_only__",
      "data.date_of_birth": "__service_role_only__",
      "data.default_credential_visibility": "__service_role_only__",
      "data.guardian_consent": "__service_role_only__",
      "data.guardian_consent_token": "__service_role_only__"
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}