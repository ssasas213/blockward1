{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Links to User entity"
    },
    "school_id": {
      "type": "string",
      "description": "Currently active school \u2014 used by RLS for data isolation. Updated when admin switches schools. Service-role only: clients can never write this field."
    },
    "active_school_id": {
      "type": "string",
      "description": "Explicit active school ID. Mirrors school_id for UI clarity and multi-school switching."
    },
    "user_type": {
      "type": "string",
      "enum": [
        "admin",
        "teacher",
        "student",
        "pending"
      ],
      "description": "Core role: admin=Approver/Org Admin, teacher=Verifier, student=Participant. 'pending' = newly provisioned account with no school yet \u2014 the user must join a school (code/invite) or create one before any role is granted. Service-role only: clients can never write this field. Roles are granted exclusively through provisionProfile (invite, join code, school creation) or an admin approval."
    },
    "role_label": {
      "type": "string",
      "description": "Custom display label for this user's role"
    },
    "admin_level": {
      "type": "string",
      "enum": [
        "super_admin",
        "head_of_year",
        "head_of_department",
        "data_manager",
        "basic_admin"
      ],
      "description": "Display label that seeds default admin_permissions on creation. Service-role only: clients can never write this field."
    },
    "admin_permissions": {
      "type": "object",
      "description": "Source of truth for what this admin may do. Seeded from admin_level on creation, then editable per-admin via setAdminPermissions. Service-role only: clients can never write this field.",
      "properties": {
        "manage_users": {
          "type": "boolean",
          "default": false
        },
        "manage_classes": {
          "type": "boolean",
          "default": false
        },
        "view_all_points": {
          "type": "boolean",
          "default": false
        },
        "edit_points": {
          "type": "boolean",
          "default": false
        },
        "view_reports": {
          "type": "boolean",
          "default": false
        },
        "manage_categories": {
          "type": "boolean",
          "default": false
        },
        "manage_school_settings": {
          "type": "boolean",
          "default": false
        },
        "view_parent_contacts": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "handle": {
      "type": "string",
      "description": "Globally unique public handle for the /@handle profile page. 3-20 chars, lowercase letters, numbers and underscores. Uniqueness (including reserved history) enforced server-side."
    },
    "handle_history": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Previous handles kept permanently reserved \u2014 old /@handle URLs redirect to the current one."
    },
    "handle_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the handle was last claimed or changed \u2014 enforces the 30-day change cooldown."
    },
    "bio": {
      "type": "string",
      "description": "Public bio shown on the public profile (max 200 characters, line breaks allowed). Plain text only \u2014 no markdown, no HTML."
    },
    "pinned_achievement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Up to 6 BlockWardVerificationRegistry ids pinned as Highlights at the top of the public profile."
    },
    "banner_url": {
      "type": "string",
      "description": "Public profile cover banner. Either an uploaded image URL (cropped to 3:1, 1500x500 on upload) or a built-in abstract banner encoded as 'preset:<id>'. Set from the bounded presets in updatePublicProfile \u2014 never free styling."
    },
    "theme_id": {
      "type": "string",
      "enum": [
        "slate",
        "midnight",
        "paper",
        "terracotta",
        "forest",
        "cobalt",
        "rose",
        "mono",
        "gradient",
        "carbon"
      ],
      "default": "slate",
      "description": "Named design preset for the public /@handle profile \u2014 background treatment, card style, border radius, shadow depth and text colour. Validated server-side."
    },
    "accent_colour": {
      "type": "string",
      "description": "Hex accent colour for the public profile, restricted to the fixed 12-colour palette \u2014 validated server-side, never a free picker."
    },
    "profile_layout": {
      "type": "string",
      "enum": [
        "grid",
        "list",
        "showcase"
      ],
      "default": "grid",
      "description": "How achievements are presented on the public profile: grid (many achievements), list (long verified record), showcase (hero treatment for pinned highlights)."
    },
    "social_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "One of the supported platforms: instagram, tiktok, linkedin, github, youtube, x, discord, behance, dribbble, strava, chesscom, website"
          },
          "url": {
            "type": "string",
            "description": "https URL (forced server-side)"
          },
          "label": {
            "type": "string",
            "description": "Optional display label (max 40 chars)"
          }
        },
        "required": [
          "platform",
          "url"
        ]
      },
      "default": [],
      "description": "Up to 6 social/profile links shown as icon buttons under the bio (link-in-bio). Rendered with rel=noopener nofollow."
    },
    "featured_link": {
      "type": "object",
      "description": "One prominent call-to-action button above the achievements \u2014 portfolio, CV, fundraiser, team page or commission form.",
      "properties": {
        "url": {
          "type": "string",
          "description": "https URL (forced server-side)"
        },
        "label": {
          "type": "string",
          "description": "Button label (max 60 chars)"
        }
      },
      "required": [
        "url"
      ]
    },
    "display_font": {
      "type": "string",
      "enum": [
        "sans",
        "serif",
        "mono",
        "display"
      ],
      "default": "sans",
      "description": "Curated heading font pairing for the public profile \u2014 one of 4 designed pairings, never a free font choice."
    },
    "profile_views": {
      "type": "number",
      "default": 0,
      "description": "Total views of the public /@handle profile. Incremented server-side only (publicProfileData) \u2014 never client-writable."
    },
    "profile_visibility": {
      "type": "string",
      "enum": [
        "public",
        "link_only",
        "private"
      ],
      "default": "public",
      "description": "Global visibility of the public /@handle profile page. Under-16 accounts are provisioned with 'private' as the safe default; the student can change it."
    },
    "leaderboard_opt_out": {
      "type": "boolean",
      "default": false,
      "description": "When true, this member is hidden from the organisation's weekly and monthly leaderboards."
    },
    "og_image_url": {
      "type": "string",
      "description": "Generated square share-card image used as the Open Graph image for the public profile."
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "default": "system",
      "description": "User's preferred UI theme"
    },
    "show_mascot_on_signin": {
      "type": "boolean",
      "default": false,
      "description": "When true, the BlockWard mascot tour launches automatically on each sign-in (once per browser session)."
    },
    "class_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Class IDs this user is associated with \u2014 teachers: classes they teach (mirrored from StaffMembership); students: classes they're enrolled in (mirrored from Enrollment). Used by RLS for class-scoped reads on Enrollment/JoinRequest/Resource/TimetableEntry. Kept in sync by joinClassByCode + class creation."
    },
    "student_id": {
      "type": "string",
      "description": "Student ID number (for students)"
    },
    "grade_level": {
      "type": "string",
      "description": "Year/Grade level (for students)"
    },
    "department": {
      "type": "string",
      "description": "Department (for teachers)"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Subjects taught (for teachers)"
    },
    "admin_email": {
      "type": "string",
      "description": "School admin email \u2014 inherited by teachers and students"
    },
    "primary_teacher_email": {
      "type": "string",
      "description": "Primary teacher email \u2014 inherited by students"
    },
    "parent_name": {
      "type": "string",
      "description": "Parent/Guardian name (for students)"
    },
    "parent_email": {
      "type": "string",
      "description": "Parent/Guardian email (for students). Doubles as the guardian email for under-13 consent \u2014 the same field managed on the student dashboard, never a separate one."
    },
    "parent_phone": {
      "type": "string",
      "description": "Parent/Guardian phone (for students)"
    },
    "parent_relationship": {
      "type": "string",
      "enum": [
        "mother",
        "father",
        "guardian",
        "other"
      ],
      "description": "Relationship of parent/guardian to student"
    },
    "parent_contact_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth, collected at signup so age-appropriate privacy and consent rules can be applied (under-13 guardian consent, under-16 private-by-default profile and link-only credentials). Age is always DERIVED server-side from this field \u2014 the user is never asked to state an age \u2014 and it is never displayed publicly. Service-role only: clients can never write this field."
    },
    "default_credential_visibility": {
      "type": "string",
      "enum": [
        "public",
        "link_only"
      ],
      "default": "public",
      "description": "Age-derived safe default applied when a new credential is published: under-16 accounts start 'link_only' so achievements are visible only to people with the share link. The student can still change each credential's visibility. Service-role only: clients can never write this field."
    },
    "guardian_consent": {
      "type": "object",
      "description": "Parent/guardian consent record for under-13 accounts. The account stays 'awaiting_guardian_consent' until consent is recorded via the emailed link. Service-role only.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "granted"
          ]
        },
        "guardian_email": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "granted_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the guardian consented \u2014 the compliance timestamp."
        },
        "granted_via": {
          "type": "string"
        }
      }
    },
    "guardian_consent_token": {
      "type": "string",
      "description": "One-time lookup token for the public /guardian-consent/:token page. Regenerated on resend, cleared after consent is recorded. Service-role only: clients can never write this field."
    },
    "wallet_address": {
      "type": "string",
      "description": "Custodial blockchain wallet address (public). Private key lives on Vaults, never here."
    },
    "portfolio_public_id": {
      "type": "string",
      "description": "Public identifier for the student's shareable portfolio (format: prt-xxxxxxxx)."
    },
    "blockchain_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "TEACHER",
        "STUDENT"
      ],
      "description": "On-chain role"
    },
    "can_issue_blockwards": {
      "type": "boolean",
      "default": true
    },
    "total_achievement_points": {
      "type": "number",
      "default": 0
    },
    "total_behaviour_points": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "pending_approval",
        "awaiting_guardian_consent"
      ],
      "default": "active",
      "description": "pending_approval: a teacher who joined with a code and is awaiting admin approval. awaiting_guardian_consent: an under-13 account that cannot be used until a parent/guardian consents via the emailed link. Service-role only: clients can never write this field."
    },
    "test_super_user": {
      "type": "boolean",
      "default": false,
      "description": "True only for the server-authorised test super user. Source of truth is the TEST_SUPER_USER_EMAIL secret."
    },
    "active_test_persona": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "admin"
      ],
      "description": "For the test super user only \u2014 which persona's experience is currently active."
    },
    "test_persona_ids": {
      "type": "object",
      "description": "For the test super user only \u2014 maps persona role \u2192 UserProfile.id of the corresponding test persona profile.",
      "properties": {
        "student": {
          "type": "string"
        },
        "teacher": {
          "type": "string"
        },
        "admin": {
          "type": "string"
        }
      }
    },
    "test_persona_of": {
      "type": "string",
      "description": "For test persona profiles only \u2014 the controller email that owns this persona."
    }
  },
  "required": [
    "user_email",
    "user_type",
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {
      "data.user_email": "__service_role_only__"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "data.school_id": "__service_role_only__",
      "data.user_type": "__service_role_only__",
      "data.admin_level": "__service_role_only__",
      "data.admin_permissions": "__service_role_only__",
      "data.status": "__service_role_only__",
      "data.date_of_birth": "__service_role_only__",
      "data.default_credential_visibility": "__service_role_only__",
      "data.guardian_consent": "__service_role_only__",
      "data.guardian_consent_token": "__service_role_only__"
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}