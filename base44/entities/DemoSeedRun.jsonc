{
  "name": "DemoSeedRun",
  "type": "object",
  "properties": {
    "run_label": {
      "type": "string",
      "description": "Identifier for this seeding run (e.g. demo-1718000000000, investor-1718000000000)."
    },
    "kind": {
      "type": "string",
      "enum": [
        "organisation",
        "investor_world"
      ],
      "default": "organisation",
      "description": "Which seeder produced this run: 'organisation' \u2014 the test organisation (seedDemoOrganisation); 'investor_world' \u2014 the investor-deck demo world (seedInvestorDemo)."
    },
    "school_id": {
      "type": "string",
      "description": "The primary demo School this run created \u2014 records scoped to it are removed with the run."
    },
    "school_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "EVERY organisation this run created \u2014 removal purges each. The investor world spans a school AND a club."
    },
    "school_name": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string",
      "description": "Email of the super admin / test super user who ran the seed."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "removed"
      ],
      "default": "active",
      "description": "active: the demo world exists. removed: every record it created has been deleted."
    },
    "teacher_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Seeded staff emails (all on the @demo.blockward.test domain)."
    },
    "student_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "EVERY seeded account email (all @demo.blockward.test). This is the demo_data manifest: removal deletes every profile by these emails, plus the school-less records (independently verified credentials, self-reported achievements) that cannot be purged by school_id."
    },
    "student_count": {
      "type": "number",
      "default": 0
    },
    "seeded_at": {
      "type": "string",
      "format": "date-time"
    },
    "removed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "run_label",
    "school_id",
    "status"
  ],
  "rls": {
    "create": {
      "data.run_label": "__service_role_only__"
    },
    "read": {
      "data.run_label": "__service_role_only__"
    },
    "update": {
      "data.run_label": "__service_role_only__"
    },
    "delete": {
      "data.run_label": "__service_role_only__"
    }
  }
}