{
  "name": "TeamCredential",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "School this team credential belongs to (RLS scope)"
    },
    "school_name": {
      "type": "string",
      "description": "Denormalised school name"
    },
    "request_id": {
      "type": "string",
      "description": "AchievementRequest.id this team credential was minted from"
    },
    "team_slug": {
      "type": "string",
      "description": "Public URL slug for the shared team credential page (/team/:slug)"
    },
    "verification_id": {
      "type": "string",
      "description": "Public verification ID (BW-\u2026) of the primary group credential"
    },
    "title": {
      "type": "string",
      "description": "Team achievement title"
    },
    "category": {
      "type": "string",
      "enum": [
        "academic",
        "sports",
        "arts",
        "leadership",
        "community",
        "behaviour",
        "special"
      ],
      "default": "special"
    },
    "description": {
      "type": "string",
      "description": "What the team achieved"
    },
    "date_achieved": {
      "type": "string",
      "format": "date"
    },
    "organisation_id": {
      "type": "string",
      "description": "Issuing organisation ID"
    },
    "organisation_name": {
      "type": "string",
      "description": "Issuing organisation display name"
    },
    "verifier_name": {
      "type": "string",
      "description": "Nominated verifier display name (public)"
    },
    "verifier_email": {
      "type": "string",
      "description": "Nominated verifier email (private)"
    },
    "admin_name": {
      "type": "string",
      "description": "Approving admin display name (public)"
    },
    "admin_email": {
      "type": "string",
      "description": "Approving admin email (private)"
    },
    "signer_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "witnessed_in_person",
              "reviewed_evidence",
              "official_records",
              "third_party",
              "other"
            ]
          },
          "method_note": {
            "type": "string"
          },
          "attestation": {
            "type": "boolean"
          },
          "ip_country": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "role",
          "timestamp"
        ]
      },
      "default": [],
      "description": "Full chain of signers who verified this team achievement \u2014 copied into each participant's personal credential."
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Participant email (private \u2014 never shown on the public team page)"
          },
          "name": {
            "type": "string",
            "description": "Participant display name (public once accepted)"
          },
          "profile_id": {
            "type": "string",
            "description": "UserProfile.id when they're on BlockWard"
          },
          "handle": {
            "type": "string",
            "description": "Public handle when they're on BlockWard \u2014 links their tile to /@handle"
          },
          "avatar_url": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "Their role in the team (captain, striker, lead developer, first board, designer\u2026)"
          },
          "on_blockward": {
            "type": "boolean",
            "default": false,
            "description": "Whether this email matches an existing BlockWard account"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "declined"
            ],
            "default": "pending",
            "description": "Consent state. Pending participants show as pending; declined participants are removed from the public team page entirely."
          },
          "token": {
            "type": "string",
            "description": "Private per-participant claim token used in /team-join/:token links. Never exposed publicly."
          },
          "responded_at": {
            "type": "string",
            "format": "date-time",
            "description": "When they accepted or declined"
          },
          "verification_id": {
            "type": "string",
            "description": "Their personal credential's verification ID (BW-\u2026) once minted on acceptance"
          }
        },
        "required": [
          "email",
          "role",
          "status"
        ]
      },
      "default": [],
      "description": "Everyone listed on this team achievement, with their role and consent state. The creator is participant #1 with status 'accepted'."
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the team achievement was approved and the group record created"
    }
  },
  "required": [
    "school_id",
    "team_slug",
    "title",
    "participants"
  ],
  "rls": {
    "create": {
      "data.school_id": "__service_role_only__"
    },
    "read": {
      "data.school_id": "__service_role_only__"
    },
    "update": {
      "data.school_id": "__service_role_only__"
    },
    "delete": {
      "data.school_id": "__service_role_only__"
    }
  }
}