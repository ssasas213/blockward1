{
  "name": "DigitalSignature",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "description": "StudentRecord.id this signature belongs to"
    },
    "school_id": {
      "type": "string"
    },
    "signer_email": {
      "type": "string"
    },
    "signer_name": {
      "type": "string",
      "description": "Display name from SignatureProfile (legal name)"
    },
    "signer_title": {
      "type": "string",
      "description": "Job title from SignatureProfile"
    },
    "signer_role": {
      "type": "string",
      "enum": [
        "admin",
        "teacher",
        "student"
      ],
      "description": "Who signed"
    },
    "signature_type": {
      "type": "string",
      "enum": [
        "typed",
        "drawn"
      ],
      "default": "typed"
    },
    "signature_value": {
      "type": "string",
      "description": "Typed name or base64 drawn signature image data URL"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "record_id",
    "school_id",
    "signer_email",
    "signer_name",
    "signer_role",
    "signature_value",
    "signed_at"
  ],
  "rls": {
    "create": {},
    "read": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.signer_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    }
  }
}