{
  "name": "AchievementRequest",
  "type": "object",
  "properties": {
    "verification_mode": {
      "type": "string",
      "enum": [
        "organisation",
        "independent"
      ],
      "default": "organisation",
      "description": "Who verifies this request. 'organisation': the existing staff flow (nominated verifier, tiers, admin approval). 'independent': a named person who was there, verified via a one-time account-free link \u2014 available to students with no organisation. Service-role only: set exclusively through the submit flow."
    },
    "school_id": {
      "type": "string",
      "description": "Target organisation for this request (RLS scope). NULL for independent-verification requests \u2014 the student has no organisation and the free-text organisation label never creates one."
    },
    "school_name": {
      "type": "string",
      "description": "Denormalised organisation name. For independent requests this is the verifier's free-text organisation label (display only, not a BlockWard organisation)."
    },
    "independent_verifier": {
      "type": "object",
      "description": "The person the student nominated to independently verify this achievement. Their one-time link, their details at sign-off time, and their anti-abuse flags all live on this request.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Verifier's full name as entered by the student"
        },
        "email": {
          "type": "string",
          "description": "Verifier email \u2014 the one-time link is sent here. Validated against self-verification aliases and disposable domains."
        },
        "role": {
          "type": "string",
          "description": "Their role, from the fixed whitelist: coach, teacher, instructor, examiner, referee, club_official, event_organiser, employer, mentor, other"
        },
        "organisation_label": {
          "type": "string",
          "description": "Their organisation as free text (e.g. 'Gracie Barra Dubai'). A DISPLAY LABEL ONLY \u2014 it never creates or links a BlockWard organisation. Matched later to offer org admins a re-verify upgrade."
        },
        "relationship": {
          "type": "string",
          "description": "The student's relationship to them, one line (e.g. 'My club coach for 3 years')"
        }
      },
      "required": [
        "name",
        "email",
        "role"
      ]
    },
    "submit_ip": {
      "type": "string",
      "description": "IP the student submitted from \u2014 compared against the verifier's confirmation IP for the shared-IP anti-abuse flag. Service-role only."
    },
    "review_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "sole_student_verifier | high_volume_verifier | shared_ip"
          },
          "detail": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "reason",
          "at"
        ]
      },
      "default": [],
      "description": "Anti-abuse review signals recorded at independent verification. Flags NEVER auto-reject \u2014 they are recorded for human review."
    },
    "false_report": {
      "type": "object",
      "description": "Recorded when an independent verifier reports the request as false. Rejects the request and notifies the student. Service-role only.",
      "properties": {
        "reason": {
          "type": "string",
          "description": "Why the verifier says the claim is false"
        },
        "name": {
          "type": "string",
          "description": "Reporting verifier's name"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "student_id": {
      "type": "string",
      "description": "UserProfile.id of the requesting student"
    },
    "student_email": {
      "type": "string",
      "description": "Requesting student email"
    },
    "student_name": {
      "type": "string",
      "description": "Denormalised student display name"
    },
    "credential_type_id": {
      "type": "string",
      "description": "AwardTypes.id of the picked credential template \u2014 null for a custom 'Other' type"
    },
    "credential_type_title": {
      "type": "string",
      "description": "Display title of the credential type (template title or student-typed label)"
    },
    "is_custom_credential": {
      "type": "boolean",
      "default": false,
      "description": "True when the student chose 'Other' and typed their own credential type"
    },
    "category": {
      "type": "string",
      "enum": [
        "academic",
        "sports",
        "arts",
        "leadership",
        "community",
        "behaviour",
        "special"
      ],
      "default": "academic",
      "description": "Achievement category"
    },
    "title": {
      "type": "string",
      "description": "Achievement title"
    },
    "description": {
      "type": "string",
      "description": "What the student did, in their words"
    },
    "image_url": {
      "type": "string",
      "description": "Student-uploaded PUBLIC cover image (auto-cropped to 4:3, compressed client-side). Decorative only \u2014 this is what appears on the public profile tiles. Moderated before it becomes public; organisation admins can remove it. Evidence lives separately in the evidence field."
    },
    "date_achieved": {
      "type": "string",
      "format": "date",
      "description": "When the achievement occurred (yyyy-MM-dd)"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "file",
              "link"
            ]
          },
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ]
      },
      "default": [],
      "description": "Evidence attachments \u2014 up to 5 uploaded files (JPG/PNG/WebP/PDF, max 10MB, images compressed client-side) and external links. Shown to verifiers; NOT public unless the student opts in."
    },
    "is_team": {
      "type": "boolean",
      "default": false,
      "description": "True when this is a group achievement \u2014 one verification and sign-off covers every listed participant, and each gets their own credential with their role once they consent. Organisation flow only; independent verification is per-student."
    },
    "my_team_role": {
      "type": "string",
      "description": "The requesting student's own role in the team (e.g. captain, lead developer, first board)"
    },
    "team_participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Teammate email \u2014 an existing BlockWard member or someone not yet on BlockWard"
          },
          "name": {
            "type": "string",
            "description": "Display name entered by the creator (or resolved from their profile)"
          },
          "profile_id": {
            "type": "string",
            "description": "UserProfile.id when the email matches an existing member"
          },
          "handle": {
            "type": "string",
            "description": "Public handle when the email matches an existing member"
          },
          "role": {
            "type": "string",
            "description": "This teammate's role in the achievement (e.g. striker, designer, second violin)"
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "default": [],
      "description": "Teammates listed by the creator for a team achievement. Each is emailed a private claim link when the credential is approved, and only appears on the public team record after accepting."
    },
    "nominated_verifier_id": {
      "type": "string",
      "description": "UserProfile.id of the nominated staff verifier"
    },
    "nominated_verifier_email": {
      "type": "string",
      "description": "Staff member the student nominated to verify this"
    },
    "nominated_verifier_name": {
      "type": "string",
      "description": "Denormalised verifier display name"
    },
    "verification_tier": {
      "type": "number",
      "enum": [
        1,
        2,
        3
      ],
      "default": 1,
      "description": "1: verifier only. 2: verifier + org admin (different people). 3: verifier + admin + external verifier via expiring link. Set by the credential type, overridable by the organisation. Null for independent-verification requests."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "changes_requested",
        "verifier_signed",
        "awaiting_second_approval",
        "awaiting_external_verification",
        "approved",
        "minted",
        "archived",
        "rejected",
        "expired",
        "withdrawn"
      ],
      "default": "draft",
      "description": "Lifecycle status. The canonical TERMINAL state is 'archived' (verified and published). 'minted' is a deprecated legacy terminal kept only for pre-migration rows \u2014 never set it in new code. 'withdrawn' \u2014 the student cancelled it before verification; it leaves the Pending count, is hidden by default, and can be duplicated into a new draft. A request that is approved or beyond can never be withdrawn \u2014 a verified credential cannot be silently unmade."
    },
    "external_verifier_email": {
      "type": "string",
      "description": "Contact email for the Tier 3 external verifier, or the independent verifier's email (reminders + anti-abuse history keyed on this)."
    },
    "external_token": {
      "type": "string",
      "description": "One-time expiring token for the external verification link. Cleared after use."
    },
    "external_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "verifier_signoff": {
      "type": "object",
      "description": "Nominated verifier's sign-off",
      "properties": {
        "signer_id": {
          "type": "string"
        },
        "signer_email": {
          "type": "string"
        },
        "signer_name": {
          "type": "string"
        },
        "signer_role": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "witnessed_in_person",
            "reviewed_evidence",
            "official_records",
            "third_party",
            "other"
          ]
        },
        "method_note": {
          "type": "string"
        },
        "attestation": {
          "type": "boolean"
        },
        "signature": {
          "type": "string",
          "description": "Typed signature (full name)"
        },
        "ip_country": {
          "type": "string",
          "description": "Country derived from the signer's IP at sign-off time"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "admin_signoff": {
      "type": "object",
      "description": "Organisation admin's second approval (Tier 2 & 3)",
      "properties": {
        "signer_id": {
          "type": "string"
        },
        "signer_email": {
          "type": "string"
        },
        "signer_name": {
          "type": "string"
        },
        "signer_role": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "witnessed_in_person",
            "reviewed_evidence",
            "official_records",
            "third_party",
            "other"
          ]
        },
        "method_note": {
          "type": "string"
        },
        "attestation": {
          "type": "boolean"
        },
        "signature": {
          "type": "string"
        },
        "ip_country": {
          "type": "string"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "external_signoff": {
      "type": "object",
      "description": "External verifier's confirmation (Tier 3, and ALL independent verifications) \u2014 recorded without a BlockWard account. Name, role, organisation, email, method, attestation, signature, IP-derived country and timestamp are all recorded here.",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "organisation": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "witnessed_in_person",
            "reviewed_evidence",
            "official_records",
            "third_party",
            "other"
          ]
        },
        "method_note": {
          "type": "string"
        },
        "attestation": {
          "type": "boolean"
        },
        "signature": {
          "type": "string"
        },
        "ip_country": {
          "type": "string"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "changes_requested_reason": {
      "type": "string",
      "description": "Reviewer's comment when sending the request back to the student"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Required reason when a reviewer rejects. Visible to the student, never shown on the public profile."
    },
    "student_flagged": {
      "type": "boolean",
      "default": false,
      "description": "Set when this student's rejection rate crossed 40% across 5+ requests \u2014 surfaces to organisation admins."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "resubmitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_reviewer_action_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last reviewer sign-off / changes / rejection \u2014 anchors the 7/21-day reminders and 30-day auto-expiry clock"
    },
    "reminder_1_at": {
      "type": "string",
      "format": "date-time"
    },
    "reminder_2_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    },
    "student_record_id": {
      "type": "string",
      "description": "StudentRecord created on final approval \u2014 the credential's source of truth. Also set by the one-time migration for converted legacy submissions."
    },
    "blockward_id": {
      "type": "string",
      "description": "BlockWard created when the credential minted"
    },
    "verification_id": {
      "type": "string",
      "description": "Public verification ID (BW-\u2026) once minted"
    },
    "event_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "description": "created | updated | submitted | resubmitted | verifier_signed | admin_approved | external_confirmed | external_declined | reported_false | changes_requested | rejected | reminded | expired | minted | migrated | flagged | withdrawn"
          },
          "actor_email": {
            "type": "string"
          },
          "actor_name": {
            "type": "string"
          },
          "actor_role": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "event",
          "timestamp"
        ]
      },
      "default": [],
      "description": "Timestamped audit trail of everything that happened to this request"
    }
  },
  "required": [
    "student_email",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "data.school_id": "__service_role_only__"
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.nominated_verifier_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "data.school_id": "__service_role_only__"
    },
    "delete": {
      "data.school_id": "__service_role_only__"
    }
  }
}