{
  "name": "AchievementRequest",
  "type": "object",
  "properties": {
    "verification_mode": {
      "type": "string",
      "enum": [
        "organisation",
        "independent"
      ],
      "default": "organisation",
      "description": "Who verifies this request. 'organisation': the existing staff flow (nominated verifier, tiers, admin approval). 'independent': a named person who was there, verified via a one-time account-free link \u2014 available to students with no organisation. Service-role only: set exclusively through the submit flow."
    },
    "school_id": {
      "type": "string",
      "description": "Target organisation for this request (RLS scope). NULL for independent-verification requests \u2014 the student has no organisation and the free-text organisation label never creates one."
    },
    "school_name": {
      "type": "string",
      "description": "Denormalised organisation name. For independent requests this is the verifier's free-text organisation label (display only, not a BlockWard organisation)."
    },
    "independent_verifier": {
      "type": "object",
      "description": "The person the student nominated to independently verify this achievement. Their one-time link, their details at sign-off time, and their anti-abuse flags all live on this request.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Verifier's full name as entered by the student"
        },
        "email": {
          "type": "string",
          "description": "Verifier email \u2014 the one-time link is sent here. Validated against self-verification aliases and disposable domains."
        },
        "role": {
          "type": "string",
          "description": "Their role, from the fixed whitelist: coach, teacher, instructor, examiner, referee, club_official, event_organiser, employer, mentor, other"
        },
        "organisation_label": {
          "type": "string",
          "description": "Their organisation as free text (e.g. 'Gracie Barra Dubai'). A DISPLAY LABEL ONLY \u2014 it never creates or links a BlockWard organisation. Matched later to offer org admins a re-verify upgrade."
        },
        "relationship": {
          "type": "string",
          "description": "The student's relationship to them, one line (e.g. 'My club coach for 3 years')"
        }
      },
      "required": [
        "name",
        "email",
        "role"
      ]
    },
    "submit_ip": {
      "type": "string",
      "description": "IP the student submitted from \u2014 compared against the verifier's confirmation IP for the shared-IP anti-abuse flag. Service-role only."
    },
    "review_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "sole_student_verifier | high_volume_verifier | shared_ip"
          },
          "detail": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "reason",
          "at"
        ]
      },
      "default": [],
      "description": "Anti-abuse review signals recorded at independent verification. Flags NEVER auto-reject \u2014 they are recorded for human review."
    },
    "false_report": {
      "type": "object",
      "description": "Recorded when an independent verifier reports the request as false. Rejects the request and notifies the student. Service-role only.",
      "properties": {
        "reason": {
          "type": "string",
          "description": "Why the verifier says the claim is false"
        },
        "name": {
          "type": "string",
          "description": "Reporting verifier's name"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "student_id": {
      "type": "string",
      "description": "UserProfile.id of the requesting student"
    },
    "student_email": {
      "type": "string",
      "description": "Requesting student email"
    },
    "student_name": {
      "type": "string",
      "description": "Denormalised student display name"
    },
    "credential_type_id": {
      "type": "string",
      "description": "AwardTypes.id of the picked credential template \u2014 null for a custom 'Other' type. ATTESTED field: part of what the signers review."
    },
    "credential_type_title": {
      "type": "string",
      "description": "Display title of the credential type (template title or student-typed label). ATTESTED field."
    },
    "is_custom_credential": {
      "type": "boolean",
      "default": false,
      "description": "True when the student chose 'Other' and typed their own credential type. ATTESTED field."
    },
    "category": {
      "type": "string",
      "enum": [
        "academic",
        "sports",
        "arts",
        "leadership",
        "community",
        "behaviour",
        "special"
      ],
      "default": "academic",
      "description": "Achievement category. ATTESTED field."
    },
    "title": {
      "type": "string",
      "description": "Achievement title. ATTESTED field \u2014 editing it after a sign-off invalidates that signature."
    },
    "description": {
      "type": "string",
      "description": "What the student did, in their words. ATTESTED field."
    },
    "image_url": {
      "type": "string",
      "description": "PRESENTATION field \u2014 the student-uploaded public cover image. Never part of any attestation: the student may change it at any time without disturbing an in-flight review. Decorative only; moderated before it becomes public."
    },
    "date_achieved": {
      "type": "string",
      "format": "date",
      "description": "When the achievement occurred (yyyy-MM-dd). ATTESTED field."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "file",
              "link"
            ]
          },
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ]
      },
      "default": [],
      "description": "Evidence attachments \u2014 up to 5 uploaded files and external links. ATTESTED field: shown to verifiers; changing it after a sign-off invalidates that signature."
    },
    "is_team": {
      "type": "boolean",
      "default": false,
      "description": "True when this is a group achievement. ATTESTED field."
    },
    "my_team_role": {
      "type": "string",
      "description": "The requesting student's own role in the team. ATTESTED field."
    },
    "team_participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "default": [],
      "description": "Teammates listed by the creator. ATTESTED field \u2014 the signer attests to this team list."
    },
    "nominated_verifier_id": {
      "type": "string",
      "description": "UserProfile.id of the nominated staff verifier"
    },
    "nominated_verifier_email": {
      "type": "string",
      "description": "Staff member the student nominated to verify this. ATTESTED field \u2014 changing the nominee changes who reviews."
    },
    "nominated_verifier_name": {
      "type": "string",
      "description": "Denormalised verifier display name"
    },
    "verification_tier": {
      "type": "number",
      "enum": [
        1,
        2,
        3
      ],
      "default": 1,
      "description": "1: verifier only. 2: verifier + org admin. 3: verifier + admin + external verifier via expiring link. Null for independent requests. ATTESTED field."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "changes_requested",
        "verifier_signed",
        "awaiting_second_approval",
        "awaiting_external_verification",
        "approved",
        "minted",
        "archived",
        "rejected",
        "expired",
        "withdrawn"
      ],
      "default": "draft",
      "description": "Lifecycle status. The canonical TERMINAL state is 'archived' (verified and published). 'withdrawn' \u2014 the student cancelled before verification. A request that is approved or beyond can never be withdrawn \u2014 a verified credential cannot be silently unmade. Service-role only: transitions happen exclusively through achievementRequestAction / credentialEditAction."
    },
    "external_verifier_email": {
      "type": "string",
      "description": "Contact email for the Tier 3 external verifier, or the independent verifier's email. ATTESTED field while a verification is in flight."
    },
    "external_token": {
      "type": "string",
      "description": "One-time expiring token for the external verification link. Cleared after use \u2014 and cleared immediately when the student edits attested details, so an outstanding verifier link can never approve content that has changed underneath it. Service-role only."
    },
    "external_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "verifier_signoff": {
      "type": "object",
      "description": "Nominated verifier's sign-off \u2014 the exact content snapshot they attested to is stored alongside it (content_hash). Service-role only.",
      "properties": {
        "signer_id": {
          "type": "string"
        },
        "signer_email": {
          "type": "string"
        },
        "signer_name": {
          "type": "string"
        },
        "signer_role": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "witnessed_in_person",
            "reviewed_evidence",
            "official_records",
            "third_party",
            "other"
          ]
        },
        "method_note": {
          "type": "string"
        },
        "attestation": {
          "type": "boolean"
        },
        "signature": {
          "type": "string",
          "description": "Typed signature (full name)"
        },
        "ip_country": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "description": "Fingerprint of the attested content at signing time"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "admin_signoff": {
      "type": "object",
      "description": "Organisation admin's second approval (Tier 2 & 3). Service-role only.",
      "properties": {
        "signer_id": {
          "type": "string"
        },
        "signer_email": {
          "type": "string"
        },
        "signer_name": {
          "type": "string"
        },
        "signer_role": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "witnessed_in_person",
            "reviewed_evidence",
            "official_records",
            "third_party",
            "other"
          ]
        },
        "method_note": {
          "type": "string"
        },
        "attestation": {
          "type": "boolean"
        },
        "signature": {
          "type": "string"
        },
        "ip_country": {
          "type": "string"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "external_signoff": {
      "type": "object",
      "description": "External verifier's confirmation \u2014 recorded without a BlockWard account. Service-role only.",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "organisation": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "witnessed_in_person",
            "reviewed_evidence",
            "official_records",
            "third_party",
            "other"
          ]
        },
        "method_note": {
          "type": "string"
        },
        "attestation": {
          "type": "boolean"
        },
        "signature": {
          "type": "string"
        },
        "ip_country": {
          "type": "string"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "changes_requested_reason": {
      "type": "string",
      "description": "Reviewer's comment when sending the request back to the student \u2014 or the system note when the student's own edit of attested details reset the review. Service-role only."
    },
    "rejection_reason": {
      "type": "string",
      "description": "Required reason when a reviewer rejects. Visible to the student, never shown on the public profile."
    },
    "student_flagged": {
      "type": "boolean",
      "default": false,
      "description": "Set when this student's rejection rate crossed 40% across 5+ requests \u2014 surfaces to organisation admins."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "resubmitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_reviewer_action_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last reviewer sign-off / changes / rejection \u2014 anchors the 7/21-day reminders and 30-day auto-expiry clock"
    },
    "reminder_1_at": {
      "type": "string",
      "format": "date-time"
    },
    "reminder_2_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    },
    "student_record_id": {
      "type": "string",
      "description": "StudentRecord created on final approval \u2014 the credential's source of truth. Service-role only."
    },
    "blockward_id": {
      "type": "string",
      "description": "BlockWard created when the credential minted"
    },
    "verification_id": {
      "type": "string",
      "description": "Public verification ID (BW-\u2026) once minted"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Credential version this request produced. Bumped when an approved correction creates a newer version of the delivered credential. Service-role only."
    },
    "previous_version_id": {
      "type": "string",
      "description": "Mirrors the StudentRecord version chain backwards for corrections. Service-role only."
    },
    "superseded_by_id": {
      "type": "string",
      "description": "Mirrors the StudentRecord version chain forwards. Service-role only."
    },
    "edit_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "old_value": {
            "description": "Value before the edit (stringified for storage)"
          },
          "new_value": {
            "description": "Value after the edit (stringified for storage)"
          },
          "edited_by": {
            "type": "string"
          },
          "edited_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "edited_at"
        ]
      },
      "default": [],
      "description": "Every edit made through the credential edit flow, with actor, old/new values and reason. Service-role only."
    },
    "correction_reason": {
      "type": "string",
      "description": "Mirrored from the delivered StudentRecord when a correction is requested on the published credential. Service-role only."
    },
    "correction_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the correction was requested. Service-role only."
    },
    "correction_approved_by": {
      "type": "string",
      "description": "Verifier who approved (or declined) the correction. Service-role only."
    },
    "event_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "description": "created | updated | submitted | resubmitted | verifier_signed | admin_approved | external_confirmed | external_declined | reported_false | changes_requested | rejected | reminded | expired | minted | migrated | flagged | withdrawn | student_edited | correction_requested | correction_approved | correction_declined"
          },
          "actor_email": {
            "type": "string"
          },
          "actor_name": {
            "type": "string"
          },
          "actor_role": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "event",
          "timestamp"
        ]
      },
      "default": [],
      "description": "Timestamped audit trail of everything that happened to this request"
    }
  },
  "required": [
    "student_email",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "data.school_id": "__service_role_only__"
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.nominated_verifier_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.profile.school_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "data.school_id": "__service_role_only__",
      "data.status": "__service_role_only__",
      "data.title": "__service_role_only__",
      "data.description": "__service_role_only__",
      "data.date_achieved": "__service_role_only__",
      "data.category": "__service_role_only__",
      "data.evidence": "__service_role_only__",
      "data.credential_type_id": "__service_role_only__",
      "data.credential_type_title": "__service_role_only__",
      "data.is_custom_credential": "__service_role_only__",
      "data.nominated_verifier_id": "__service_role_only__",
      "data.nominated_verifier_email": "__service_role_only__",
      "data.nominated_verifier_name": "__service_role_only__",
      "data.verification_tier": "__service_role_only__",
      "data.external_verifier_email": "__service_role_only__",
      "data.is_team": "__service_role_only__",
      "data.my_team_role": "__service_role_only__",
      "data.team_participants": "__service_role_only__",
      "data.verifier_signoff": "__service_role_only__",
      "data.admin_signoff": "__service_role_only__",
      "data.external_signoff": "__service_role_only__",
      "data.external_token": "__service_role_only__",
      "data.external_token_expires_at": "__service_role_only__",
      "data.approved_at": "__service_role_only__",
      "data.blockward_id": "__service_role_only__",
      "data.verification_id": "__service_role_only__",
      "data.student_record_id": "__service_role_only__",
      "data.version": "__service_role_only__",
      "data.previous_version_id": "__service_role_only__",
      "data.superseded_by_id": "__service_role_only__",
      "data.edit_history": "__service_role_only__",
      "data.correction_reason": "__service_role_only__",
      "data.correction_requested_at": "__service_role_only__",
      "data.correction_approved_by": "__service_role_only__"
    },
    "delete": {
      "data.school_id": "__service_role_only__"
    }
  }
}