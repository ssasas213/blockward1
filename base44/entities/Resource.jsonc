{
  "name": "Resource",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "pdf",
        "document",
        "image",
        "video",
        "link",
        "other"
      ]
    },
    "file_size": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "class_id",
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.profile.school_id}}",
      "data.teacher_email": "{{user.email}}"
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "data.class_id": {
            "$in": "{{user.profile.class_ids}}"
          }
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.teacher_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.teacher_email": "{{user.email}}"
        }
      ]
    }
  }
}