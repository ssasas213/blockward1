{
  "name": "School",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "School name"
    },
    "code": {
      "type": "string",
      "description": "Unique school code"
    },
    "student_join_code": {
      "type": "string",
      "description": "Code for students to join the school"
    },
    "teacher_join_code": {
      "type": "string",
      "description": "Code for teachers to join the school"
    },
    "address": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "admin_email": {
      "type": "string",
      "description": "Primary admin email"
    },
    "settings": {
      "type": "object",
      "description": "School-specific settings"
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      },
      "data.admin_email": "{{user.email}}"
    },
    "read": {
      "data.id": "{{user.profile.school_id}}"
    },
    "update": {
      "data.id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          },
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin",
            "admin_level": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin",
        "admin_level": "super_admin"
      }
    }
  }
}