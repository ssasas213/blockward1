{
  "name": "School",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization name"
    },
    "code": {
      "type": "string",
      "description": "Unique organization code"
    },
    "school_code": {
      "type": "string",
      "description": "Single hierarchy code teachers use to join this school. Admin sets this when creating the school."
    },
    "org_type": {
      "type": "string",
      "enum": [
        "school",
        "sports_club",
        "martial_arts_academy",
        "chess_club",
        "competition_organizer",
        "training_provider",
        "music_academy",
        "debate_organization",
        "stem_competition",
        "corporate_training",
        "other"
      ],
      "default": "school",
      "description": "Type of organization"
    },
    "country": {
      "type": "string",
      "description": "Country where the organization is located"
    },
    "city": {
      "type": "string",
      "description": "City where the organization is located"
    },
    "website": {
      "type": "string",
      "description": "Organization website (optional)"
    },
    "student_join_code": {
      "type": "string",
      "description": "Legacy code (deprecated)"
    },
    "teacher_join_code": {
      "type": "string",
      "description": "Legacy code (deprecated)"
    },
    "address": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "admin_email": {
      "type": "string",
      "description": "Primary admin email \u2014 owner of this school"
    },
    "admin_title": {
      "type": "string",
      "description": "Title of the administrator (e.g., Principal, Headmaster, Director)"
    },
    "settings": {
      "type": "object",
      "description": "Organization-specific settings",
      "properties": {
        "role_labels": {
          "type": "object",
          "properties": {
            "student": {
              "type": "string"
            },
            "teacher": {
              "type": "string"
            },
            "admin": {
              "type": "string"
            }
          }
        },
        "credential_label": {
          "type": "string"
        },
        "branding": {
          "type": "object",
          "properties": {
            "primary_color": {
              "type": "string"
            },
            "secondary_color": {
              "type": "string"
            }
          }
        },
        "verification_process": {
          "type": "object"
        },
        "archive_destination": {
          "type": "string",
          "enum": [
            "student_drive",
            "school_drive",
            "selected_drive"
          ],
          "default": "student_drive"
        }
      }
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "create": {
      "data.admin_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "data.id": "{{user.profile.school_id}}"
        }
      ]
    },
    "delete": {
      "data.admin_email": "{{user.email}}"
    }
  }
}