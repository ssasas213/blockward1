{
  "name": "AwardTypes",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "Unique code like TOP_HELPER"
    },
    "title": {
      "type": "string",
      "description": "Display title like 'Top Helper'"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "academic",
        "sports",
        "arts",
        "leadership",
        "community",
        "special"
      ]
    },
    "verification_tier": {
      "type": "number",
      "enum": [
        1,
        2,
        3
      ],
      "default": 1,
      "description": "Approval requirement for credentials of this type: 1 = nominated teacher/verifier approval only, 2 = verifier + organisation admin approval, 3 = verifier + admin + external verifier. Organisations override by editing the template."
    },
    "requires_evidence": {
      "type": "boolean",
      "default": true,
      "description": "Evidence requirement for this credential type \u2014 enforced server-side at submit. True (the default): students must attach at least one evidence file or link before submitting. Explicitly false: the organisation has opted this type out, and submissions without evidence are accepted. Types created before the field existed (undefined) are treated as required."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    }
  }
}