{
  "name": "AwardTypes",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Unique code like TOP_HELPER"
    },
    "title": {
      "type": "string",
      "description": "Display title like 'Top Helper'"
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      },
      "data.school_id": "{{user.profile.school_id}}"
    }
  }
}