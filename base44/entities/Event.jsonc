{
  "name": "Event",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "School this event belongs to"
    },
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "enum": [
        "whole_school",
        "year_7",
        "year_8",
        "year_9",
        "year_10",
        "year_11",
        "staff_only",
        "custom"
      ],
      "default": "whole_school"
    },
    "audience_class_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "start_time",
    "created_by"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.profile.school_id}}"
    },
    "read": {
      "data.school_id": "{{user.profile.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.profile.school_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.profile.school_id}}",
      "user_condition": {
        "role": "admin"
      }
    }
  }
}