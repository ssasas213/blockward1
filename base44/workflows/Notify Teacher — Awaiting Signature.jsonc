{
  "name": "Notify Teacher \u2014 Awaiting Signature",
  "description": "Single canonical dispatcher \u2014 inspects old/new status and notifies the correct party (teacher/admins/student) with deep links. Idempotent via last_notified_status. Fires only when the status field changes.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "StudentRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_teacher_awaiting_signature",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyOnRecordStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyOnRecordStatusChange"
  }
}