export const DEFAULT_ORG_TYPE = 'school';

export function getOrgTypeConfig(orgType) {
  return ORG_TYPES.find(t => t.value === orgType) || ORG_TYPES.find(t => t.value === DEFAULT_ORG_TYPE);
}

export function getRoleLabel(orgType, role) {
  const config = getOrgTypeConfig(orgType);
  return config?.roleLabels?.[role] || ORG_TYPES[0].roleLabels[role] || role;
}

export function getCredentialLabel(orgType) {
  const config = getOrgTypeConfig(orgType);
  return config?.credentialLabel || 'Credential';
}